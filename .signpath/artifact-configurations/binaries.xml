<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Pulsar" company-name="oMaN-Rod" product-version="${version}" file-version="${version}" original-filename="${file.name}">
      <include path="pulsar.exe" />
      <include path="pulsar-settings.exe" />
      <include path="pulsar-details.exe" />
      <include path="pulsar-sensors.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
