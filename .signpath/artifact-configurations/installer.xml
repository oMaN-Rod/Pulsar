<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- Inno Setup pads these strings with spaces to 60, 60, 50 and 20 characters, and parameters lose trailing spaces, so the padding here assumes a 5-character version. -->
    <pe-file path="pulsar-${version}-setup.exe" product-name="Pulsar                                                      " company-name="oMaN-Rod                                                    " product-version="${version}                                             " file-version="${version}               ">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
