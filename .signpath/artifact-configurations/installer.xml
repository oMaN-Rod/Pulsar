<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="paddedProductVersion" required="true" />
    <parameter name="paddedFileVersion" required="true" />
  </parameters>
  <zip-file>
    <!-- Inno Setup pads its version strings with spaces to fixed widths: 60, 50 and 20 characters. -->
    <pe-file path="pulsar-${version}-setup.exe" product-name="Pulsar                                                      " company-name="oMaN-Rod                                                    " product-version="${paddedProductVersion}" file-version="${paddedFileVersion}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
