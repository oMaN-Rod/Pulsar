import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";

// A graph style for the picker; `thumb` is drawn in a 64 × 34 box.
export struct StyleChoice {
    name: string,
    thumb: string,
    stroke: float,
    filled: bool,
}

export struct ItemRow {
    id: string,
    name: string,
    enabled: bool,
    color: string,
    swatch: color,
    // Indexes into the styles, color-modes and item-popup-details lists.
    style: int,
    style-set: int,
    trend: bool,
    color-mode: int,
    popup: int,
    // 0 follows the Popups page.
    popup-width: int,
    popup-graph-height: int,
    // 0 is automatic.
    tile-width: int,
    tile-height: int,
    // Empty uses the default, which is shown in its place.
    label: string,
    short-label: string,
    default-label: string,
    default-short-label: string,
    expanded: bool,
}

// A theme picker card: its name and the colors its preview is drawn in.
export struct ThemeCard {
    name: string,
    taskbar: color,
    panel: color,
    tile: color,
    label: color,
    text: color,
    items: [color],
}

// Shows a shortcut, and records the next key pressed while it has focus.
component HotkeyField inherits Rectangle {
    in property <string> text;
    callback pressed(KeyEvent);
    width: 180px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: keys.has-focus ? Palette.accent-background : Palette.border;
    background: Palette.control-background;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                return reject;
            }
            root.pressed(event);
            accept
        }
    }
    TouchArea {
        clicked => { keys.focus(); }
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        vertical-alignment: center;
        overflow: elide;
        color: root.text == "" && !keys.has-focus ? Palette.control-foreground.transparentize(45%) : Palette.control-foreground;
        text: keys.has-focus ? @tr("Press keys…") : root.text == "" ? @tr("Not set") : root.text;
    }
}

export struct WidgetItemRow {
    id: string,
    name: string,
    checked: bool,
    // 0 follows the widget; otherwise one more than an index into the
    // style and detail lists.
    style: int,
    is-cpu: bool,
    detail: int,
}

export struct ProfileRow {
    name: string,
    active: bool,
}

export struct DriveRow {
    letter: string,
    checked: bool,
}

// A GPU or network adapter that can have cells of its own.
export struct DeviceRow {
    label: string,
    value: string,
    checked: bool,
}

export struct SearchResult {
    id: string,
    title: string,
    path: string,
    description: string,
}

// The row a search result opened, while it comes into view and stays marked.
export global SearchJump {
    in-out property <int> tab;
    in-out property <string> title;
    // Set instead of the title for a row whose title is not unique on its page.
    in-out property <string> key;
    // Waiting for the row to report where it is.
    in-out property <bool> pending;
    // The row did not report: another option hides it right now.
    in-out property <bool> missing;
    in-out property <length> row-top;
    in-out property <length> row-height;
    in-out property <int> arrivals;
}

// Glyphs from the Segoe Fluent Icons font that ships with Windows 11.
global Icons {
    out property <string> settings: "\u{E713}";
    out property <string> display: "\u{E7F4}";
    out property <string> list: "\u{EA37}";
    out property <string> info: "\u{E946}";
    out property <string> up: "\u{E70E}";
    out property <string> grip: "\u{E76F}";
    out property <string> down: "\u{E70D}";
    out property <string> folder: "\u{E8B7}";
    out property <string> chart: "\u{E9D9}";
    out property <string> options: "\u{E713}";
    out property <string> palette: "\u{E790}";
    out property <string> popup: "\u{E8BD}";
    out property <string> sensor: "\u{E950}";
    out property <string> drive: "\u{EDA2}";
    out property <string> widget: "\u{ECA5}";
    out property <string> profiles: "\u{E81E}";
}

component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Palette.foreground.transparentize(0.9) : transparent;
    Icon {
        text: root.icon;
        font-size: 12px;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(0.7);
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The list whose row is being dragged: 0 none, 1 Items, 2 widget items.
global RowDrag {
    in-out property <int> list;
    in-out property <int> from;
    in-out property <int> over;
    in-out property <bool> after;
    in-out property <length> pointer-y;
}

component DragHandle inherits Rectangle {
    callback started(length);
    callback dragged(length);
    callback released();
    width: 24px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
    Icon {
        text: Icons.grip;
        font-size: 12px;
        color: Palette.foreground.transparentize(0.3);
    }
    touch := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        changed pressed => {
            if (self.pressed) {
                root.started(root.absolute-position.y + self.pressed-y);
            } else {
                root.released();
            }
        }
        moved => { root.dragged(root.absolute-position.y + self.mouse-y); }
    }
}

component ResultRow inherits Rectangle {
    in property <SearchResult> result;
    callback clicked();
    background: touch.has-hover ? Palette.foreground.transparentize(0.92) : transparent;
    border-radius: 6px;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        Text {
            text: root.result.title;
            font-size: 14px;
            overflow: elide;
        }
        Text {
            text: root.result.path;
            font-size: 12px;
            color: Palette.accent-background;
            overflow: elide;
        }
        if root.result.description != "": Text {
            text: root.result.description;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.35);
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Palette.alternate-background : touch.has-hover ? Palette.alternate-background.transparentize(0.5) : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 16px : 0;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Icon {
            text: root.icon;
            width: 20px;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A heading over a group of navigation items.
component NavGroup inherits Rectangle {
    in property <string> text;
    height: 30px;
    Text {
        x: 14px;
        y: parent.height - self.height - 4px;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Palette.foreground.transparentize(0.45);
    }
}

// A miniature overlay in the theme's colors: graph tiles with a label line
// and a value line on a strip of taskbar.
component ThemeTile inherits Rectangle {
    in property <ThemeCard> theme;
    in property <bool> selected;
    callback clicked();
    width: 136px;
    height: 100px;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 68px;
            border-radius: 8px;
            clip: true;
            background: root.theme.taskbar;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Palette.accent-background : touch.has-hover ? Palette.border : Palette.border.transparentize(0.5);
            Rectangle {
                x: 8px;
                y: 16px;
                width: parent.width - 16px;
                height: 36px;
                border-radius: 4px;
                background: root.theme.panel;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    for c[i] in root.theme.items: Rectangle {
                        background: root.theme.tile;
                        border-radius: 3px;
                        Rectangle {
                            x: 3px;
                            y: 3px;
                            width: parent.width * 0.55;
                            height: 3px;
                            border-radius: 1.5px;
                            background: root.theme.label;
                        }
                        Rectangle {
                            x: 3px;
                            y: 9px;
                            width: parent.width * 0.75;
                            height: 4px;
                            border-radius: 2px;
                            background: root.theme.text;
                        }
                        Rectangle {
                            property <float> level: [0.75, 0.45, 0.9, 0.6][i];
                            x: 0;
                            width: parent.width;
                            height: (parent.height - 16px) * self.level;
                            y: parent.height - self.height;
                            border-radius: 2px;
                            background: c.transparentize(0.25);
                        }
                    }
                }
            }
        }
        Text {
            text: root.theme.name;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Theme cards in as many columns as fit.
component ThemeGrid inherits Rectangle {
    in property <[ThemeCard]> themes;
    in property <int> selected;
    callback clicked(int);
    property <length> step-x: 136px + 12px;
    property <length> step-y: 100px + 10px;
    property <int> columns: Math.max(1, Math.floor((self.width + 12px) / self.step-x));
    min-height: Math.ceil(self.themes.length / self.columns) * self.step-y;
    for t[i] in root.themes: ThemeTile {
        x: Math.mod(i, root.columns) * root.step-x;
        y: Math.floor(i / root.columns) * root.step-y;
        theme: t;
        selected: i == root.selected;
        clicked => { root.clicked(i); }
    }
}

// One graph style: a small drawing of it and its name.
component StyleTile inherits Rectangle {
    in property <StyleChoice> choice;
    in property <bool> selected;
    in property <color> tint;
    callback clicked();
    width: 96px;
    height: 78px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.95);
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: root.selected ? Palette.accent-background
        : focus.has-focus ? Palette.foreground
        : Palette.foreground.transparentize(0.92);
    accessible-role: button;
    accessible-label: root.choice.name;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        alignment: start;
        Rectangle {
            height: 34px;
            if root.choice.thumb != "": Path {
                width: 64px;
                height: 34px;
                viewbox-width: 64;
                viewbox-height: 34;
                commands: root.choice.thumb;
                fill: root.choice.filled ? root.tint.transparentize(0.6) : transparent;
                stroke: root.tint;
                stroke-width: root.choice.stroke * 1px;
            }
            if root.choice.thumb == "": Text {
                text: "Aa";
                font-size: 18px;
                color: root.tint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.choice.name;
            font-size: 11px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component StylePicker inherits Rectangle {
    in property <[StyleChoice]> choices;
    in property <int> selected;
    in property <color> tint;
    callback picked(int);
    property <length> step-x: 96px + 8px;
    property <length> step-y: 78px + 8px;
    property <int> columns: Math.max(1, Math.floor((self.width + 8px) / self.step-x));
    min-height: Math.ceil(self.choices.length / self.columns) * self.step-y;
    for c[i] in root.choices: StyleTile {
        x: Math.mod(i, root.columns) * root.step-x;
        y: Math.floor(i / root.columns) * root.step-y;
        choice: c;
        selected: i == root.selected;
        tint: root.tint;
        clicked => { root.picked(i); }
    }
}

// Three thresholds on the color by load scale: drag a handle, or focus one and
// use the arrow keys. A handle stops at its neighbours, so they stay in order.
component LoadThresholdRibbon inherits Rectangle {
    in-out property <int> moderate;
    in-out property <int> high;
    in-out property <int> critical;
    in property <int> minimum: 1;
    in property <int> maximum;
    in property <bool> logarithmic;
    in property <color> low-color;
    in property <color> moderate-color;
    in property <color> high-color;
    in property <color> critical-color;
    callback edited();
    property <int> active: 0;
    property <bool> dragging;
    property <length> inset: 8px;
    property <length> span: self.width - 2 * self.inset;
    pure function fraction(value: int) -> float {
        if (root.logarithmic) {
            return Math.log(value / root.minimum, 10) / Math.log(root.maximum / root.minimum, 10);
        }
        return (value - root.minimum) / (root.maximum - root.minimum);
    }
    pure function position(value: int) -> length {
        return root.inset + root.span * root.fraction(value);
    }
    pure function value-at(x: length) -> int {
        let at = Math.clamp((x - root.inset) / root.span, 0, 1);
        if (root.logarithmic) {
            return Math.round(root.minimum * Math.pow(root.maximum / root.minimum, at));
        }
        return Math.round(root.minimum + at * (root.maximum - root.minimum));
    }
    pure function pick(x: length) -> int {
        let a = Math.abs(x - root.position(root.moderate));
        let b = Math.abs(x - root.position(root.high));
        let c = Math.abs(x - root.position(root.critical));
        let best = Math.min(a, b, c);
        // Handles on one spot: the one that is free to move towards the pointer.
        if (x >= root.position(root.critical) && c == best) {
            return 2;
        }
        if (x >= root.position(root.high) && b == best) {
            return 1;
        }
        if (a == best) {
            return 0;
        }
        if (b == best) {
            return 1;
        }
        return 2;
    }
    function move(handle: int, value: int) {
        if (handle == 0) {
            root.moderate = Math.clamp(value, root.minimum, root.high);
        } else if (handle == 1) {
            root.high = Math.clamp(value, root.moderate, root.critical);
        } else {
            root.critical = Math.clamp(value, root.high, root.maximum);
        }
    }
    function nudge(handle: int, event: KeyEvent) -> EventResult {
        let step = event.modifiers.shift ? 10 : 1;
        let current = handle == 0 ? root.moderate : handle == 1 ? root.high : root.critical;
        if (event.text == Key.LeftArrow) {
            root.move(handle, current - step);
        } else if (event.text == Key.RightArrow) {
            root.move(handle, current + step);
        } else {
            return reject;
        }
        root.edited();
        return accept;
    }
    width: 300px;
    height: 58px;
    Rectangle {
        x: root.inset;
        y: 23px;
        width: root.span;
        height: 12px;
        border-radius: 6px;
        clip: true;
        Rectangle {
            x: 0;
            width: root.position(root.moderate) - root.inset;
            background: root.low-color;
        }
        Rectangle {
            x: root.position(root.moderate) - root.inset;
            width: root.position(root.high) - root.position(root.moderate);
            background: root.moderate-color;
        }
        Rectangle {
            x: root.position(root.high) - root.inset;
            width: root.position(root.critical) - root.position(root.high);
            background: root.high-color;
        }
        Rectangle {
            x: root.position(root.critical) - root.inset;
            width: root.span - self.x;
            background: root.critical-color;
        }
    }
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.cancel && root.dragging) {
                root.dragging = false;
                root.edited();
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.active = root.pick(self.mouse-x);
                if (root.active == 0) {
                    moderate-focus.focus();
                } else if (root.active == 1) {
                    high-focus.focus();
                } else {
                    critical-focus.focus();
                }
                root.move(root.active, root.value-at(self.mouse-x));
            } else if (event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.edited();
            }
        }
        moved => {
            if (root.dragging) {
                root.move(root.active, root.value-at(self.mouse-x));
            }
        }
    }
    Text {
        x: root.position(root.moderate) - self.width / 2;
        y: 2px;
        text: root.moderate;
        font-size: 12px;
    }
    Rectangle {
        x: root.position(root.moderate) - 5px;
        y: 19px;
        width: 10px;
        height: 20px;
        border-radius: 3px;
        background: Palette.foreground;
        border-width: moderate-focus.has-focus ? 2px : 1px;
        border-color: moderate-focus.has-focus ? Palette.accent-background : Palette.background;
        accessible-role: slider;
        accessible-value: root.moderate;
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.high;
        accessible-label: @tr("Moderate from");
        moderate-focus := FocusScope {
            key-pressed(event) => { return root.nudge(0, event); }
        }
    }
    Text {
        x: root.position(root.high) - self.width / 2;
        y: 41px;
        text: root.high;
        font-size: 12px;
    }
    Rectangle {
        x: root.position(root.high) - 5px;
        y: 19px;
        width: 10px;
        height: 20px;
        border-radius: 3px;
        background: Palette.foreground;
        border-width: high-focus.has-focus ? 2px : 1px;
        border-color: high-focus.has-focus ? Palette.accent-background : Palette.background;
        accessible-role: slider;
        accessible-value: root.high;
        accessible-value-minimum: root.moderate;
        accessible-value-maximum: root.critical;
        accessible-label: @tr("High from");
        high-focus := FocusScope {
            key-pressed(event) => { return root.nudge(1, event); }
        }
    }
    Text {
        x: root.position(root.critical) - self.width / 2;
        y: 2px;
        text: root.critical;
        font-size: 12px;
    }
    Rectangle {
        x: root.position(root.critical) - 5px;
        y: 19px;
        width: 10px;
        height: 20px;
        border-radius: 3px;
        background: Palette.foreground;
        border-width: critical-focus.has-focus ? 2px : 1px;
        border-color: critical-focus.has-focus ? Palette.accent-background : Palette.background;
        accessible-role: slider;
        accessible-value: root.critical;
        accessible-value-minimum: root.high;
        accessible-value-maximum: root.maximum;
        accessible-label: @tr("Critical from");
        critical-focus := FocusScope {
            key-pressed(event) => { return root.nudge(2, event); }
        }
    }
}

// A setting: title and description on the left, its control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> available: true;
    in property <string> search-key;
    // A title wrapping in a repeated row pushes the rows out of the list's card.
    in property <bool> single-line-title;
    property <bool> targeted: root.available && (root.search-key != ""
        ? root.search-key == SearchJump.key
        : root.title != "" && root.title == SearchJump.title);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    Timer {
        interval: 1ms;
        running: root.targeted && SearchJump.pending;
        triggered => {
            SearchJump.pending = false;
            SearchJump.row-top = root.absolute-position.y;
            SearchJump.row-height = root.height;
            SearchJump.arrivals += 1;
        }
    }
    column := VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        label := Text {
            text: root.title;
            font-size: 14px;
            wrap: root.single-line-title ? no-wrap : word-wrap;
            overflow: elide;
            // A child of the text, so that the row's layout does not measure it.
            Rectangle {
                x: -column.x;
                y: -column.y - label.y;
                width: root.width;
                height: root.height;
                border-radius: 6px;
                background: root.targeted ? Palette.accent-background.transparentize(0.75) : transparent;
                animate background { duration: 200ms; }
            }
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.35);
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        horizontal-stretch: 0;
        spacing: 8px;
        @children
    }
}

// For a row whose description can wrap: `if` would measure it at its unwrapped
// width and leave the extra lines out of the card's height.
component OptionalRow inherits Rectangle {
    in property <bool> shown;
    in property <string> title;
    in property <string> description;
    in property <string> search-key;
    in property <length> row-padding: 12px;
    visible: root.shown;
    height: root.shown ? row.preferred-height : 0;
    row := SettingRow {
        title: root.title;
        description: root.description;
        available: root.shown;
        search-key: root.search-key;
        padding-top: root.row-padding;
        padding-bottom: root.row-padding;
        @children
    }
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border.transparentize(0.6);
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border.transparentize(0.7);
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
}

export global ColorUtil {
    in property <[color]> swatches;
    pure callback hex(color) -> string;
}

component Swatch inherits Rectangle {
    in property <color> value;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.value;
}

component HueBar inherits Rectangle {
    in-out property <float> hue;
    callback edited();
    height: 14px;
    border-radius: 7px;
    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
    function pick(x: length) {
        root.hue = Math.clamp(x / root.width, 0, 1) * 359.9;
        root.edited();
    }
    Rectangle {
        x: root.hue / 360 * root.width - self.width / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, 1, 1);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// Saturation left to right, brightness top to bottom.
component SaturationValueArea inherits Rectangle {
    in property <float> hue;
    in-out property <float> saturation;
    in-out property <float> value;
    callback edited();
    border-radius: 6px;
    background: hsv(root.hue, 1, 1);
    function pick(x: length, y: length) {
        root.saturation = Math.clamp(x / root.width, 0, 1);
        root.value = 1 - Math.clamp(y / root.height, 0, 1);
        root.edited();
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
    }
    Rectangle {
        x: root.saturation * root.width - self.width / 2;
        y: (1 - root.value) * root.height - self.height / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, root.saturation, root.value);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x, self.mouse-y);
            }
        }
        moved => { root.pick(self.mouse-x, self.mouse-y); }
    }
}

// Where a reading turns yellow, orange and red. Each edit keeps them in order.
// A color setting: a swatch that opens a picker, and the hex text.
component ColorField inherits HorizontalLayout {
    in-out property <string> text;
    // Transparent when the text is empty or half-typed.
    in property <color> swatch;
    // Where the picker starts when there is no valid color.
    in property <color> fallback;
    in property <string> placeholder: "#RRGGBB";
    in property <length> field-width: 140px;
    // Typed or picked; empty means the default.
    callback edited(string);
    property <float> hue;
    property <float> saturation;
    property <float> value;
    spacing: 8px;

    function set(hex: string) {
        root.text = hex;
        root.edited(hex);
    }
    function picked() {
        root.set(ColorUtil.hex(hsv(root.hue, root.saturation, root.value)));
    }
    function start-from(c: color) {
        let h = c.to-hsv();
        root.hue = h.hue;
        root.saturation = h.saturation;
        root.value = h.value;
    }

    swatch-button := Rectangle {
        width: 28px;
        height: 28px;
        Swatch {
            value: root.swatch;
            border-color: touch.has-hover ? Palette.accent-background : Palette.border;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.start-from(root.swatch.to-hsv().alpha > 0 ? root.swatch : root.fallback);
                picker.show();
            }
        }
    }
    LineEdit {
        width: root.field-width;
        placeholder-text: root.placeholder;
        text <=> root.text;
        edited(text) => { root.edited(text); }
    }

    picker := PopupWindow {
        x: swatch-button.x + swatch-button.width - self.width;
        y: swatch-button.y + swatch-button.height + 6px;
        width: 268px;
        height: content.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
        }
        content := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            SaturationValueArea {
                height: 150px;
                hue: root.hue;
                saturation <=> root.saturation;
                value <=> root.value;
                edited => { root.picked(); }
            }
            HueBar {
                hue <=> root.hue;
                edited => { root.picked(); }
            }
            Rectangle {
                property <int> columns: 9;
                property <length> step: 27px;
                height: Math.ceil(ColorUtil.swatches.length / self.columns) * self.step - 7px;
                for c[i] in ColorUtil.swatches: Rectangle {
                    x: Math.mod(i, parent.columns) * parent.step;
                    y: Math.floor(i / parent.columns) * parent.step;
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: preset-touch.has-hover ? Palette.accent-background : Palette.border;
                    background: c;
                    preset-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.start-from(c);
                            root.picked();
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Swatch {
                    value: hsv(root.hue, root.saturation, root.value);
                }
                Text {
                    text: root.text == "" ? @tr("Default") : root.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Use default");
                    enabled: root.text != "";
                    clicked => {
                        root.set("");
                        picker.close();
                    }
                }
            }
        }
    }
}

// Owns its scroll view: an `if` instance inside one's layout is measured at its
// unwrapped width, which leaves wrapped text out of the content height.
component Page inherits ScrollView {
    in property <string> title;
    property <int> arrivals: SearchJump.arrivals;
    // Scrolls to rows beyond the view while one is dragged.
    Timer {
        interval: 30ms;
        running: RowDrag.list != 0;
        triggered => {
            let y = RowDrag.pointer-y - root.absolute-position.y;
            let step = y < 40px ? 12px : y > root.visible-height - 40px ? -12px : 0px;
            root.content-y = Math.clamp(root.content-y + step, Math.min(0px, root.visible-height - root.content-height), 0px);
        }
    }
    changed arrivals => {
        let top = SearchJump.row-top - root.absolute-position.y - root.content-y;
        let centred = (root.visible-height - SearchJump.row-height) / 2 - top;
        root.content-y = Math.clamp(centred, Math.min(0px, root.visible-height - root.content-height), 0px);
    }
    VerticalLayout {
        width: root.visible-width;
        padding: 28px;
        padding-top: 20px;
        spacing: 12px;
        alignment: start;
        Timer {
            interval: 300ms;
            running: SearchJump.pending;
            triggered => {
                SearchJump.pending = false;
                SearchJump.missing = true;
            }
        }
        VerticalLayout {
            Text {
                text: root.title;
                font-size: 28px;
                font-weight: 600;
            }
            Rectangle {
                visible: SearchJump.missing;
                height: SearchJump.missing ? note.preferred-height + 8px : 0;
                note := Text {
                    y: 8px;
                    width: parent.width;
                    text: @tr("This setting isn't showing right now. Another option controls when it appears.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
            }
        }
        @children
    }
}

export component SettingsWindow inherits Window {
    function load-preset(pm: int, ph: int, pc: int, tm: int, th: int, tc: int, nm: int, nh: int, nc: int) {
        root.load-percent-moderate = pm;
        root.load-percent-high = ph;
        root.load-percent-critical = pc;
        root.load-temperature-moderate = root.alert-fahrenheit ? Math.round(tm * 9 / 5 + 32) : tm;
        root.load-temperature-high = root.alert-fahrenheit ? Math.round(th * 9 / 5 + 32) : th;
        root.load-temperature-critical = root.alert-fahrenheit ? Math.round(tc * 9 / 5 + 32) : tc;
        root.load-ping-moderate = nm;
        root.load-ping-high = nh;
        root.load-ping-critical = nc;
        root.changed();
    }
    in property <string> window-title;
    title: root.window-title;
    icon: @image-url("../assets/pulsar-64.png");
    preferred-width: 820px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 480px;
    background: Palette.background;
    // Read by the app to color the native title bar to match.
    out property <brush> backdrop: Palette.background;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Set per language by the app.
    in property <string> ui-font: "Segoe UI Variable Text";
    default-font-family: root.ui-font;

    in-out property <int> tab;
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> tray-icon;
    in-out property <int> sample-interval-ms;
    in-out property <bool> battery-interval-on;
    in-out property <int> battery-interval-ms;
    in-out property <int> history-len;
    in-out property <int> mode;
    in-out property <bool> graph-inline;
    in-out property <bool> vertical-labels;
    in-out property <bool> hover-popup;
    in-out property <int> position;
    in-out property <int> offset-px;
    in-out property <int> fallback-margin-px;
    in-out property <int> font-size-pt;
    in-out property <int> text-item-gap;
    in-out property <int> text-label-gap;
    in-out property <int> text-row-gap;
    in-out property <bool> show-on-all-taskbars;
    in property <[string]> taskbar-monitors;
    in-out property <int> taskbar-monitor-index;
    in-out property <bool> fit-to-taskbar;
    in-out property <int> fit-remove-from;
    in-out property <int> fit-no-room;
    in-out property <bool> fit-other-side;
    in-out property <bool> accent-graphs;
    in-out property <string> tile-color;
    in property <color> tile-swatch;
    in property <color> tile-default;
    in-out property <bool> tile-opacity-custom;
    in-out property <float> tile-opacity;
    in-out property <string> panel-color;
    in property <color> panel-swatch;
    in property <color> panel-default;
    in-out property <bool> panel-opacity-custom;
    in-out property <float> panel-opacity;
    in-out property <[ItemRow]> items;
    in-out property <string> ping-host;
    in-out property <int> ping-interval-ms;
    in-out property <bool> alert-cpu;
    in-out property <int> alert-cpu-limit;
    in-out property <bool> alert-gpu;
    in-out property <int> alert-gpu-limit;
    in-out property <bool> alert-battery;
    in-out property <int> alert-battery-limit;
    in-out property <bool> alert-drives;
    in-out property <int> alert-drives-limit;
    // The unit the temperature limits were filled in.
    in property <bool> alert-fahrenheit;
    in-out property <string> load-low-color;
    in-out property <string> load-moderate-color;
    in-out property <string> load-high-color;
    in-out property <string> load-critical-color;
    in property <color> load-low-swatch;
    in property <color> load-moderate-swatch;
    in property <color> load-high-swatch;
    in property <color> load-critical-swatch;
    property <color> load-low-shown: root.load-low-swatch.to-hsv().alpha > 0 ? root.load-low-swatch : #6CCB5F;
    property <color> load-moderate-shown: root.load-moderate-swatch.to-hsv().alpha > 0 ? root.load-moderate-swatch : #FFD33D;
    property <color> load-high-shown: root.load-high-swatch.to-hsv().alpha > 0 ? root.load-high-swatch : #FF8C1A;
    property <color> load-critical-shown: root.load-critical-swatch.to-hsv().alpha > 0 ? root.load-critical-swatch : #FF4D4F;
    in-out property <int> load-percent-moderate;
    in-out property <int> load-percent-high;
    in-out property <int> load-percent-critical;
    in-out property <int> load-temperature-moderate;
    in-out property <int> load-temperature-high;
    in-out property <int> load-temperature-critical;
    in-out property <int> load-ping-moderate;
    in-out property <int> load-ping-high;
    in-out property <int> load-ping-critical;
    in property <string> hotkey-show-hide;
    in property <string> hotkey-widget;
    in property <string> hotkey-details;
    in property <string> hotkey-record;
    in property <string> hotkey-next-profile;
    // Which shortcut, the key's text, then Ctrl, Alt, Shift and Win.
    callback hotkey-pressed(int, string, bool, bool, bool, bool);
    in property <string> version;
    in property <string> config-path;
    in property <string> logs-path;
    in property <string> repo-url;
    in property <string> issues-url;
    in-out property <int> labels;
    in-out property <bool> icons;
    in-out property <bool> hide-in-fullscreen;
    in-out property <bool> attach-to-taskbar;
    in-out property <bool> lock-position;
    in-out property <string> label-color;
    in property <color> label-swatch;
    in property <color> label-default;
    in-out property <string> value-color;
    in property <color> value-swatch;
    in property <color> value-default;
    in-out property <string> label-color-light;
    in property <color> label-light-swatch;
    in-out property <string> value-color-light;
    in property <color> value-light-swatch;
    in-out property <bool> color-labels;
    in-out property <int> temperature-unit;
    in-out property <int> memory-unit;
    in-out property <int> network-unit;
    in-out property <int> min-down;
    in-out property <int> min-down-unit;
    in-out property <int> min-up;
    in-out property <int> min-up-unit;
    in property <bool> network-floor-bits;
    property <[string]> network-floor-units: root.network-floor-bits ? ["bps", "Kbps", "Mbps"] : ["B/s", "KB/s", "MB/s"];
    in-out property <bool> upload-on-top;
    in-out property <int> network-show;
    in-out property <bool> network-split-tiles;
    in-out property <int> network-popup-show;
    in-out property <string> network-down-label;
    in-out property <string> network-up-label;
    in-out property <bool> game-strip;
    in-out property <bool> game-summary;
    in-out property <int> popup-detail;
    in-out property <bool> popup-graph;
    in-out property <bool> popup-translucent;
    in-out property <int> popup-processes;
    in-out property <int> popup-width;
    in-out property <int> popup-graph-height;
    in property <[[StyleChoice]]> style-sets;
    in property <[string]> color-modes;
    in property <[string]> popup-details;
    in property <[string]> item-popup-details;
    in property <string> diagnostics-status;
    in property <string> update-status;
    in property <bool> update-checking;
    in property <string> update-url;
    in property <string> update-notes;
    in property <[string]> fonts;
    in-out property <int> font-index;
    in-out property <bool> font-bold;
    in property <[ThemeCard]> themes;
    in-out property <int> theme-index;
    in property <string> theme-status;
    in-out property <string> theme-name;
    in property <[ProfileRow]> profiles;
    in property <string> profile-status;
    in-out property <string> profile-name;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[string]> frame-monitors;
    in-out property <int> frame-monitor-index;
    in-out property <[DriveRow]> drive-rows;
    in-out property <[DeviceRow]> gpu-rows;
    in-out property <[DeviceRow]> adapter-rows;
    in-out property <bool> widget-enabled;
    in-out property <int> widget-layer;
    in-out property <int> widget-style;
    in-out property <bool> widget-lock;
    in-out property <bool> widget-click-through;
    in-out property <int> widget-detail;
    in-out property <int> widget-width;
    in-out property <float> widget-opacity;
    in-out property <bool> widget-hide-in-fullscreen;
    in-out property <bool> widget-own-items;
    in-out property <[WidgetItemRow]> widget-items;
    in-out property <bool> widget-order-custom;
    in-out property <string> widget-background;
    in property <color> widget-background-swatch;
    in property <color> widget-background-default;
    in property <[string]> widget-item-styles;
    in property <[string]> cpu-widget-item-styles;
    in property <[string]> widget-item-details;
    in-out property <bool> per-drive;
    in-out property <bool> drive-used;
    in-out property <bool> per-gpu;
    in-out property <bool> per-adapter;
    property <bool> confirm-reset;
    in-out property <string> search-text;
    in property <[SearchResult]> search-results;

    changed tab => {
        if (root.tab != SearchJump.tab) {
            SearchJump.title = "";
            SearchJump.key = "";
            SearchJump.pending = false;
            SearchJump.missing = false;
        }
    }
    Timer {
        interval: 3s;
        running: SearchJump.title != "" || SearchJump.key != "";
        triggered => {
            SearchJump.title = "";
            SearchJump.key = "";
        }
    }

    // Any edit; the app saves shortly after the last one.
    callback changed();
    callback item-enabled(int, bool);
    callback item-color(int, string);
    // Row, field (0 style, 1 color mode, 2 popup) and the chosen index.
    callback item-choice(int, int, int);
    callback limit-label(string) -> string;
    callback item-expanded(int, bool);
    callback move-item(int, bool);
    callback drop-item(int, int, bool);
    callback drop-widget-item(int, int, bool);
    callback save-diagnostics();
    callback open-config-folder();
    callback open-logs-folder();
    callback open-link(string);
    callback check-for-update();
    callback apply-theme(int);
    callback save-theme(string);
    callback open-themes-folder();
    callback save-profile(string);
    callback apply-profile(int);
    callback delete-profile(int);
    callback open-profiles-folder();
    callback reset-all();
    callback reset-position();
    callback drive-toggled(int, bool);
    callback gpu-toggled(int, bool);
    callback adapter-toggled(int, bool);
    callback widget-item-toggled(int, bool);
    // Row, which choice (0 style, 1 detail), new index.
    callback widget-item-choice(int, int, int);
    callback per-drive-selected();
    callback per-gpu-selected();
    callback per-adapter-selected();
    callback search-edited(string);
    callback search-open(string);

    HorizontalLayout {
        // Navigation
        VerticalLayout {
            width: 230px;
            padding: 12px;
            padding-top: 8px;
            spacing: 4px;
            search-box := LineEdit {
                placeholder-text: @tr("Search settings");
                text <=> root.search-text;
                edited(text) => { root.search-edited(text); }
                accepted => {
                    if (root.search-results.length > 0) {
                        self.clear-focus();
                        root.search-open(root.search-results[0].id);
                    }
                }
                key-pressed(event) => {
                    if (event.text != Key.Escape) {
                        return reject;
                    }
                    root.search-text = "";
                    root.search-edited("");
                    accept
                }
                changed has-focus => {
                    if (self.has-focus && root.search-text != "") {
                        root.search-edited(root.search-text);
                    }
                }
            }
            NavGroup { text: @tr("Overlay"); }
            NavItem {
                icon: Icons.list;
                label: @tr("Items");
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            NavItem {
                icon: Icons.display;
                label: @tr("Layout");
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
            NavItem {
                icon: Icons.palette;
                label: @tr("Theme");
                selected: root.tab == 2;
                clicked => { root.tab = 2; }
            }
            NavItem {
                icon: Icons.popup;
                label: @tr("Popups");
                selected: root.tab == 3;
                clicked => { root.tab = 3; }
            }
            NavItem {
                icon: Icons.widget;
                label: @tr("Widget");
                selected: root.tab == 4;
                clicked => { root.tab = 4; }
            }
            NavGroup { text: @tr("Readings"); }
            NavItem {
                icon: Icons.sensor;
                label: @tr("Sensors");
                selected: root.tab == 5;
                clicked => { root.tab = 5; }
            }
            NavItem {
                icon: Icons.drive;
                label: @tr("Devices");
                selected: root.tab == 6;
                clicked => { root.tab = 6; }
            }
            NavGroup { text: @tr("App"); }
            NavItem {
                icon: Icons.profiles;
                label: @tr("Profiles");
                selected: root.tab == 9;
                clicked => { root.tab = 9; }
            }
            NavItem {
                icon: Icons.settings;
                label: @tr("General");
                selected: root.tab == 7;
                clicked => { root.tab = 7; }
            }
            NavItem {
                icon: Icons.info;
                label: @tr("About");
                selected: root.tab == 8;
                clicked => { root.tab = 8; }
            }
            Rectangle { }
        }

        // Content
            if root.tab == -1: Page {
                title: @tr("Search results");
                if root.search-results.length == 0: Text {
                    text: @tr("No settings match your search.");
                    color: Palette.foreground.transparentize(0.35);
                }
                if root.search-results.length > 0: Card {
                    for found[i] in root.search-results: VerticalLayout {
                        if i > 0: Divider { }
                        ResultRow {
                            result: found;
                            clicked => {
                                search-box.clear-focus();
                                root.search-open(found.id);
                            }
                        }
                    }
                }
            }

            if root.tab == 0: Page {
                title: @tr("Items");
                Text {
                    text: @tr("Choose what the overlay shows, its order, and each item's color (empty uses the default). Open an item's options for its graph style, coloring and popup. Right-click an item on the taskbar for the same options.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    for row[i] in root.items: item-row := VerticalLayout {
                            property <int> drop-side: RowDrag.list == 1 && RowDrag.pointer-y >= self.absolute-position.y && RowDrag.pointer-y < self.absolute-position.y + self.height
                                ? (RowDrag.pointer-y > self.absolute-position.y + self.height / 2 ? 2 : 1) : 0;
                            changed drop-side => {
                                if (self.drop-side != 0) {
                                    RowDrag.over = i;
                                    RowDrag.after = self.drop-side == 2;
                                }
                            }
                        if i > 0: Divider { }
                        SettingRow {
                            title: row.name;
                            search-key: row.id;
                            single-line-title: true;
                            IconButton {
                                icon: Icons.options;
                                clicked => { root.item-expanded(i, !row.expanded); }
                            }
                            ColorField {
                                text: row.color;
                                swatch: row.swatch;
                                fallback: row.swatch;
                                placeholder: @tr("Default");
                                field-width: 120px;
                                edited(text) => { root.item-color(i, text); }
                            }
                            DragHandle {
                                started(y) => {
                                    RowDrag.from = i;
                                    RowDrag.over = i;
                                    RowDrag.after = false;
                                    RowDrag.pointer-y = y;
                                    RowDrag.list = 1;
                                }
                                dragged(y) => { RowDrag.pointer-y = y; }
                                released => {
                                    RowDrag.list = 0;
                                    root.drop-item(RowDrag.from, RowDrag.over, RowDrag.after);
                                }
                            }
                            IconButton {
                                icon: Icons.up;
                                enabled: i > 0;
                                clicked => { root.move-item(i, true); }
                            }
                            IconButton {
                                icon: Icons.down;
                                enabled: i < root.items.length - 1;
                                clicked => { root.move-item(i, false); }
                            }
                            Switch {
                                checked: row.enabled;
                                toggled => { root.item-enabled(i, self.checked); }
                            }
                        }
                        if row.expanded: VerticalLayout {
                            padding-left: 24px;
                            padding-bottom: 4px;
                            OptionalRow {
                                title: @tr("Overlay label");
                                description: root.labels == 2 ? @tr("Labels are off on the Layout page, so this doesn't show.")
                                    : row.id == "item/Network" ? @tr("Set Download label and Upload label on the Devices page.")
                                    : row.id == "item/Disk" && root.per-drive ? @tr("With a cell per drive, the overlay shows drive letters instead.")
                                    : @tr("Replaces the name on the overlay, up to 12 characters. Settings and popups keep the item's name.");
                                search-key: row.id + "/Overlay label";
                                shown: true;
                                row-padding: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    LineEdit {
                                        width: 140px;
                                        enabled: root.labels != 2 && row.id != "item/Network";
                                        placeholder-text: row.default-label;
                                        text <=> row.label;
                                        edited(text) => {
                                            let limited = root.limit-label(text);
                                            if (limited != text) {
                                                self.text = limited;
                                            }
                                            root.changed();
                                        }
                                    }
                                }
                            }
                            OptionalRow {
                                title: @tr("Short overlay label");
                                description: root.labels == 2 ? @tr("Labels are off on the Layout page, so this doesn't show.")
                                    : row.id == "item/Network" ? @tr("Set Download label and Upload label on the Devices page.")
                                    : row.id == "item/Disk" && root.per-drive ? @tr("With a cell per drive, the overlay shows drive letters instead.")
                                    : @tr("Used with short labels, and when the overlay shrinks to fit the taskbar.");
                                search-key: row.id + "/Short overlay label";
                                shown: true;
                                row-padding: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    LineEdit {
                                        width: 140px;
                                        enabled: root.labels != 2 && row.id != "item/Network";
                                        placeholder-text: row.default-short-label;
                                        text <=> row.short-label;
                                        edited(text) => {
                                            let limited = root.limit-label(text);
                                            if (limited != text) {
                                                self.text = limited;
                                            }
                                            root.changed();
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.mode == 0;
                                height: root.mode == 0 ? style-column.preferred-height : 0;
                                style-column := VerticalLayout {
                                    SettingRow {
                                        title: @tr("Graph style");
                                        search-key: row.id + "/Graph style";
                                        available: root.mode == 0;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                    }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-bottom: 4px;
                                        StylePicker {
                                            choices: root.style-sets[row.style-set];
                                            selected: row.style;
                                            tint: row.swatch;
                                            picked(index) => { root.item-choice(i, 0, index); }
                                        }
                                    }
                                }
                            }
                            OptionalRow {
                                title: @tr("Trend arrow");
                                description: @tr("Shows whether the latest reading is above or below the recent average.");
                                search-key: row.id + "/Trend arrow";
                                shown: root.mode == 0;
                                row-padding: 4px;
                                Switch {
                                    checked: row.trend;
                                    toggled => { root.item-choice(i, 7, self.checked ? 1 : 0); }
                                }
                            }
                            OptionalRow {
                                title: @tr("Tile width");
                                description: @tr("Turn off for automatic. A tile never gets narrower than its text. A wider overlay can cover taskbar buttons.");
                                search-key: row.id + "/Tile width";
                                shown: root.mode == 0;
                                row-padding: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    item-tile-width := SpinBox {
                                        width: 140px;
                                        enabled: row.tile-width > 0;
                                        minimum: 16;
                                        maximum: 400;
                                        step-size: 4;
                                        value: row.tile-width > 0 ? row.tile-width : 80;
                                        edited(value) => { root.item-choice(i, 5, value); }
                                    }
                                }
                                Switch {
                                    checked: row.tile-width > 0;
                                    toggled => {
                                        if (!self.checked) {
                                            item-tile-width.value = 80;
                                        }
                                        root.item-choice(i, 5, self.checked ? item-tile-width.value : 0);
                                    }
                                }
                            }
                            OptionalRow {
                                title: @tr("Tile height");
                                description: @tr("Turn off for automatic. On the taskbar a tile stays within the bar and is centred; a floating overlay grows to fit it.");
                                search-key: row.id + "/Tile height";
                                shown: root.mode == 0;
                                row-padding: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    item-tile-height := SpinBox {
                                        width: 140px;
                                        enabled: row.tile-height > 0;
                                        minimum: 16;
                                        maximum: 200;
                                        step-size: 4;
                                        value: row.tile-height > 0 ? row.tile-height : 32;
                                        edited(value) => { root.item-choice(i, 6, value); }
                                    }
                                }
                                Switch {
                                    checked: row.tile-height > 0;
                                    toggled => {
                                        if (!self.checked) {
                                            item-tile-height.value = 32;
                                        }
                                        root.item-choice(i, 6, self.checked ? item-tile-height.value : 0);
                                    }
                                }
                            }
                            SettingRow {
                                title: @tr("Color");
                                search-key: row.id + "/Color";
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.color-modes;
                                    current-index: row.color-mode;
                                    selected => { root.item-choice(i, 1, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Popup detail");
                                search-key: row.id + "/Popup detail";
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.item-popup-details;
                                    current-index: row.popup;
                                    selected => { root.item-choice(i, 2, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Popup width");
                                search-key: row.id + "/Popup width";
                                padding-top: 4px;
                                padding-bottom: 4px;
                                item-width := SpinBox {
                                    width: 140px;
                                    enabled: row.popup-width > 0;
                                    minimum: 220;
                                    maximum: 800;
                                    step-size: 20;
                                    value: row.popup-width > 0 ? row.popup-width : root.popup-width;
                                    edited(value) => { root.item-choice(i, 3, value); }
                                }
                                Switch {
                                    checked: row.popup-width > 0;
                                    toggled => {
                                        if (!self.checked) {
                                            item-width.value = root.popup-width;
                                        }
                                        root.item-choice(i, 3, self.checked ? item-width.value : 0);
                                    }
                                }
                            }
                            SettingRow {
                                title: @tr("Popup graph height");
                                search-key: row.id + "/Popup graph height";
                                padding-top: 4px;
                                padding-bottom: 4px;
                                item-graph := SpinBox {
                                    width: 140px;
                                    enabled: row.popup-graph-height > 0;
                                    minimum: 24;
                                    maximum: 400;
                                    step-size: 8;
                                    value: row.popup-graph-height > 0 ? row.popup-graph-height : root.popup-graph-height;
                                    edited(value) => { root.item-choice(i, 4, value); }
                                }
                                Switch {
                                    checked: row.popup-graph-height > 0;
                                    toggled => {
                                        if (!self.checked) {
                                            item-graph.value = root.popup-graph-height;
                                        }
                                        root.item-choice(i, 4, self.checked ? item-graph.value : 0);
                                    }
                                }
                            }
                        }
                        // Sized zero, so the row's layout does not measure what it draws.
                        Rectangle {
                            height: 0;
                            Rectangle {
                                visible: RowDrag.list == 1 && RowDrag.from == i;
                                y: -item-row.height;
                                height: item-row.height;
                                background: Palette.foreground.transparentize(0.92);
                            }
                            Rectangle {
                                visible: RowDrag.list == 1 && RowDrag.over == i && RowDrag.from != i;
                                y: RowDrag.after ? -2px : -item-row.height;
                                height: 2px;
                                background: Palette.accent-background;
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Color by load thresholds"); }
                Text {
                    text: @tr("An item set to color by load changes color as its value reaches each threshold. Drag a handle, or focus it and use the arrow keys. Other values keep the item color.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Presets");
                        description: @tr("Balanced is the default.");
                        Button {
                            text: @tr("Balanced");
                            clicked => { root.load-preset(50, 75, 90, 70, 80, 90, 50, 100, 200); }
                        }
                        Button {
                            text: @tr("Relaxed");
                            clicked => { root.load-preset(70, 85, 95, 80, 90, 95, 100, 200, 400); }
                        }
                        Button {
                            text: @tr("Strict");
                            clicked => { root.load-preset(30, 55, 80, 60, 70, 80, 30, 60, 120); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Percent (%)");
                        description: @tr("Default: 50, 75, 90");
                        LoadThresholdRibbon {
                            low-color: root.load-low-shown;
                            moderate-color: root.load-moderate-shown;
                            high-color: root.load-high-shown;
                            critical-color: root.load-critical-shown;
                            maximum: 100;
                            moderate <=> root.load-percent-moderate;
                            high <=> root.load-percent-high;
                            critical <=> root.load-percent-critical;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: root.alert-fahrenheit ? @tr("Temperature (°F)") : @tr("Temperature (°C)");
                        description: root.alert-fahrenheit ? @tr("Default: 158, 176, 194") : @tr("Default: 70, 80, 90");
                        LoadThresholdRibbon {
                            low-color: root.load-low-shown;
                            moderate-color: root.load-moderate-shown;
                            high-color: root.load-high-shown;
                            critical-color: root.load-critical-shown;
                            minimum: root.alert-fahrenheit ? 34 : 1;
                            maximum: root.alert-fahrenheit ? 302 : 150;
                            moderate <=> root.load-temperature-moderate;
                            high <=> root.load-temperature-high;
                            critical <=> root.load-temperature-critical;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Ping (ms)");
                        description: @tr("Default: 50, 100, 200");
                        LoadThresholdRibbon {
                            low-color: root.load-low-shown;
                            moderate-color: root.load-moderate-shown;
                            high-color: root.load-high-shown;
                            critical-color: root.load-critical-shown;
                            logarithmic: true;
                            maximum: 5000;
                            moderate <=> root.load-ping-moderate;
                            high <=> root.load-ping-high;
                            critical <=> root.load-ping-critical;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Low color");
                        description: @tr("Below the first threshold. Empty uses green.");
                        ColorField {
                            text <=> root.load-low-color;
                            swatch: root.load-low-swatch;
                            fallback: #6CCB5F;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Moderate color");
                        description: @tr("From the first threshold. Empty uses yellow.");
                        ColorField {
                            text <=> root.load-moderate-color;
                            swatch: root.load-moderate-swatch;
                            fallback: #FFD33D;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("High color");
                        description: @tr("From the second threshold. Empty uses orange.");
                        ColorField {
                            text <=> root.load-high-color;
                            swatch: root.load-high-swatch;
                            fallback: #FF8C1A;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Critical color");
                        description: @tr("From the third threshold. Empty uses red.");
                        ColorField {
                            text <=> root.load-critical-color;
                            swatch: root.load-critical-swatch;
                            fallback: #FF4D4F;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 1: Page {
                title: @tr("Layout");
                Card {
                    SettingRow {
                        title: @tr("Mode");
                        description: @tr("Graphs, or compact text only.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Graphs"), @tr("Text only")];
                            current-index <=> root.mode;
                            selected => { root.changed(); }
                        }
                    }
                    if root.mode == 0: Divider { }
                    OptionalRow {
                        shown: root.mode == 0;
                        title: @tr("Single-line graphs");
                        description: @tr("Put the icon, label and value on one line, for short taskbars.");
                        Switch {
                            enabled: !root.vertical-labels;
                            checked <=> root.graph-inline;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Vertical labels");
                        description: @tr("Stack each label one letter per line, with the value beside it.");
                        Switch {
                            checked <=> root.vertical-labels;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Labels");
                        description: @tr("Full names, one letter per item (C, H, W, M, G, T, D, P), or none with icons alone.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Full"), @tr("Short"), @tr("None (icons only)")];
                            current-index <=> root.labels;
                            selected => {
                                if (root.labels == 2) {
                                    root.icons = true;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Icons");
                        description: @tr("An icon before each label, or on its own.");
                        Switch {
                            checked <=> root.icons;
                            toggled => {
                                if (!self.checked && root.labels == 2) {
                                    root.labels = 0;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Hide in fullscreen");
                        description: @tr("Fade out while a fullscreen game or video is in front.");
                        Switch {
                            checked <=> root.hide-in-fullscreen;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Text"); }
                Card {
                    SettingRow {
                        title: @tr("Font");
                        description: @tr("Fonts without fixed-width digits may shift slightly as values change.");
                        ComboBox {
                            width: 220px;
                            model: root.fonts;
                            current-index <=> root.font-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Bold");
                        Switch {
                            checked <=> root.font-bold;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Font size");
                        description: @tr("Points. On the taskbar, the text of two-line graphs only grows as far as the taskbar can hold it.");
                        SpinBox {
                            width: 140px;
                            minimum: 6;
                            maximum: 20;
                            value <=> root.font-size-pt;
                            edited => { root.changed(); }
                        }
                    }
                    if root.mode == 1: Divider { }
                    OptionalRow {
                        shown: root.mode == 1;
                        title: @tr("Space between items");
                        description: @tr("Pixels between columns, or between items on a vertical taskbar. A wider overlay can cover taskbar buttons.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 40;
                            value <=> root.text-item-gap;
                            edited => { root.changed(); }
                        }
                    }
                    if root.mode == 1: Divider { }
                    OptionalRow {
                        shown: root.mode == 1;
                        title: @tr("Space after labels");
                        description: @tr("Pixels between a label and its value. A wider overlay can cover taskbar buttons.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 16;
                            value <=> root.text-label-gap;
                            edited => { root.changed(); }
                        }
                    }
                    if root.mode == 1: Divider { }
                    OptionalRow {
                        shown: root.mode == 1;
                        title: @tr("Space between rows");
                        description: @tr("Pixels between rows. On the taskbar, it shrinks to what fits and never removes a row.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 16;
                            value <=> root.text-row-gap;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Position"); }
                Card {
                    SettingRow {
                        title: @tr("Placement");
                        description: @tr("Where the overlay sits on the taskbar.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Next to the tray"), @tr("Left edge"), @tr("Floating")];
                            current-index <=> root.position;
                            selected => { root.changed(); }
                        }
                    }
                    if root.position == 2: Divider { }
                    OptionalRow {
                        shown: root.position == 2;
                        title: @tr("Lock position");
                        description: @tr("Drag the overlay to move it. Add a panel background so it stays readable over any window.");
                        Button {
                            text: @tr("Reset position");
                            clicked => { root.reset-position(); }
                        }
                        Switch {
                            checked <=> root.lock-position;
                            toggled => { root.changed(); }
                        }
                    }
                    if root.position != 2: Divider { }
                    OptionalRow {
                        shown: root.position != 2;
                        title: @tr("Attach to the taskbar");
                        description: @tr("Keeps items visible while Start is open. Turn this off if the taskbar misbehaves; items then hide while Start is open.");
                        Switch {
                            checked <=> root.attach-to-taskbar;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Offset");
                        description: @tr("Extra space in pixels, moving away from the anchor.");
                        SpinBox {
                            width: 140px;
                            minimum: -2000;
                            maximum: 2000;
                            step-size: 4;
                            value <=> root.offset-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray fallback margin");
                        description: @tr("Used when the tray position cannot be read.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 2000;
                            step-size: 10;
                            value <=> root.fallback-margin-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Every taskbar");
                        description: @tr("Also show on the taskbars of other monitors.");
                        Switch {
                            checked <=> root.show-on-all-taskbars;
                            toggled => { root.changed(); }
                        }
                    }
                    if root.position != 2 && !root.show-on-all-taskbars: Divider { }
                    OptionalRow {
                        shown: root.position != 2 && !root.show-on-all-taskbars;
                        title: @tr("Taskbar");
                        description: @tr("Which monitor's taskbar to use. If that monitor is not connected, the primary one is used.");
                        ComboBox {
                            width: 200px;
                            model: root.taskbar-monitors;
                            current-index <=> root.taskbar-monitor-index;
                            selected => { root.changed(); }
                        }
                    }
                }
                if root.position != 2: SectionTitle { text: @tr("When the taskbar is full"); }
                if root.position != 2: Card {
                    SettingRow {
                        title: @tr("Fit to the taskbar");
                        description: @tr("Leaves items as they are until they would cover taskbar buttons. Then items get more compact, are removed one at a time, and finally follow the choice below.");
                        Switch {
                            checked <=> root.fit-to-taskbar;
                            toggled => { root.changed(); }
                        }
                    }
                    if root.fit-to-taskbar: Divider { }
                    OptionalRow {
                        shown: root.fit-to-taskbar;
                        title: @tr("Remove items starting from");
                        description: @tr("The side items go from first, in the order they are shown.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("The right"), @tr("The left")];
                            current-index <=> root.fit-remove-from;
                            selected => { root.changed(); }
                        }
                    }
                    if root.fit-to-taskbar: Divider { }
                    OptionalRow {
                        shown: root.fit-to-taskbar;
                        title: @tr("When no item fits");
                        description: @tr("A tray icon shows the first item's value; its tooltip lists the rest.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Float above the taskbar"), @tr("Show in the tray icon"), @tr("Stay hidden")];
                            current-index <=> root.fit-no-room;
                            selected => { root.changed(); }
                        }
                    }
                    if root.fit-to-taskbar: Divider { }
                    OptionalRow {
                        shown: root.fit-to-taskbar;
                        title: @tr("Use the other side first");
                        description: @tr("On a centred taskbar, moves items to the other side of the buttons before making them smaller.");
                        Switch {
                            checked <=> root.fit-other-side;
                            toggled => { root.changed(); }
                        }
                    }
                    if root.fit-to-taskbar: Divider { }
                    OptionalRow {
                        shown: root.fit-to-taskbar;
                        title: @tr("If the taskbar cannot be read");
                        description: @tr("Some custom taskbars do not report their buttons, and Windows may not answer for a while. Items then stay in their usual place at full size, where they can cover taskbar buttons.");
                    }
                }
            }

            if root.tab == 2: Page {
                title: @tr("Theme");
                ThemeGrid {
                    themes: root.themes;
                    selected: root.theme-index;
                    clicked(i) => { root.apply-theme(i); }
                }
                Text {
                    text: @tr("A theme sets item, label, value, tile and panel colors, with a variant for light taskbars. Choosing one clears the custom colors below.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Save as a theme");
                        description: root.theme-status != "" ? root.theme-status : @tr("Keeps the current colors as a new theme in the themes folder.");
                        LineEdit {
                            width: 160px;
                            placeholder-text: @tr("Name");
                            text <=> root.theme-name;
                        }
                        Button {
                            text: @tr("Save");
                            enabled: root.theme-name != "";
                            clicked => {
                                root.save-theme(root.theme-name);
                                root.theme-name = "";
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Themes folder");
                        description: @tr("Theme files to share or edit. Changes show after choosing the theme again.");
                        Button {
                            text: @tr("Open");
                            clicked => { root.open-themes-folder(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Custom colors"); }
                Card {
                    SettingRow {
                        title: @tr("Label color");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.label-color;
                            swatch: root.label-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value color");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.value-color;
                            swatch: root.value-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Label color on a light taskbar");
                        description: @tr("Empty uses the label color above.");
                        ColorField {
                            text <=> root.label-color-light;
                            swatch: root.label-light-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value color on a light taskbar");
                        description: @tr("Empty uses the value color above.");
                        ColorField {
                            text <=> root.value-color-light;
                            swatch: root.value-light-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Color labels by item");
                        description: @tr("Draw each label in its item's color.");
                        Switch {
                            checked <=> root.color-labels;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Accent color graphs");
                        description: @tr("Draw graphs in your Windows accent color.");
                        Switch {
                            checked <=> root.accent-graphs;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Background"); }
                Card {
                    SettingRow {
                        title: @tr("Tile color");
                        description: @tr("Empty uses the theme tint.");
                        ColorField {
                            text <=> root.tile-color;
                            swatch: root.tile-swatch;
                            fallback: root.tile-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Custom tile opacity");
                        description: root.tile-opacity-custom ? @tr("{}% — 0% removes the tiles.", Math.round(root.tile-opacity)) : @tr("Using the theme default.");
                        Slider {
                            width: 160px;
                            enabled: root.tile-opacity-custom;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.tile-opacity;
                            changed => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.tile-opacity-custom;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Panel color");
                        description: @tr("A panel behind the whole overlay. Empty uses the theme.");
                        ColorField {
                            text <=> root.panel-color;
                            swatch: root.panel-swatch;
                            fallback: root.panel-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Custom panel opacity");
                        description: !root.panel-opacity-custom ? @tr("Using the theme default.") : root.panel-opacity > 0 ? "\{Math.round(root.panel-opacity)}%" : @tr("Off");
                        Slider {
                            width: 160px;
                            enabled: root.panel-opacity-custom;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.panel-opacity;
                            changed => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.panel-opacity-custom;
                            toggled => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 3: Page {
                title: @tr("Popups");
                Card {
                    SettingRow {
                        title: @tr("Details on hover");
                        description: @tr("Show a graph and details when the mouse rests on an item.");
                        Switch {
                            checked <=> root.hover-popup;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Detail");
                        description: @tr("Simple shows the value and its graph; Detailed adds everything Pulsar reads. Items can choose their own on the Items page.");
                        ComboBox {
                            width: 200px;
                            model: root.popup-details;
                            current-index <=> root.popup-detail;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Translucent background");
                        description: @tr("Blur what is behind the popup. If Windows does not allow it, popups stay solid.");
                        Switch {
                            checked <=> root.popup-translucent;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Graph");
                        description: @tr("The recent history at the top of each popup.");
                        Switch {
                            checked <=> root.popup-graph;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Top processes");
                        description: @tr("Processes listed for CPU, memory, GPU and disk; 0 hides the lists.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 15;
                            value <=> root.popup-processes;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Width");
                        description: @tr("Pixels at 100 % scaling. Items can choose their own on the Items page.");
                        SpinBox {
                            width: 140px;
                            minimum: 220;
                            maximum: 800;
                            step-size: 20;
                            value <=> root.popup-width;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Graph height");
                        description: @tr("Pixels at 100 % scaling. The graph shrinks when a popup would not fit on the monitor. Items can choose their own on the Items page.");
                        SpinBox {
                            width: 140px;
                            minimum: 24;
                            maximum: 400;
                            step-size: 8;
                            value <=> root.popup-graph-height;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 4: Page {
                title: @tr("Widget");
                Text {
                    text: @tr("A panel on the desktop with a graph and details for each item, like a popup that stays open. Drag it to move it; right-click it for the menu.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Show the widget");
                        Switch {
                            checked <=> root.widget-enabled;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Placement");
                        description: @tr("On the desktop stays behind your windows and comes forward when you show the desktop.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("On the desktop"), @tr("Always on top")];
                            current-index <=> root.widget-layer;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lock position");
                        Switch {
                            checked <=> root.widget-lock;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Click-through while locked");
                        description: @tr("Clicks go to whatever is underneath. Unlock it from the tray icon's menu.");
                        Switch {
                            enabled: root.widget-lock;
                            checked <=> root.widget-click-through;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Hide in fullscreen");
                        description: @tr("While a fullscreen app is on the widget's monitor.");
                        Switch {
                            checked <=> root.widget-hide-in-fullscreen;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Look"); }
                Card {
                    SettingRow {
                        title: @tr("Style");
                        description: @tr("Sparklines: a line per item with a small graph. Tiles: a grid of small graphs. Meters: a bar for the current value. Dials: a grid of rings.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Sparklines"), @tr("Tiles"), @tr("Meters"), @tr("Dials")];
                            current-index <=> root.widget-style;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Detail");
                        description: root.widget-style == 1 ? @tr("Tiles show the value and graph only.") : root.widget-style == 3 ? @tr("Dials show the value only.") : @tr("How much each item shows. Colors follow the theme.");
                        ComboBox {
                            width: 200px;
                            model: root.popup-details;
                            current-index <=> root.widget-detail;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Width");
                        description: @tr("Pixels at 100 % scaling.");
                        SpinBox {
                            width: 140px;
                            minimum: 220;
                            maximum: 600;
                            step-size: 20;
                            value <=> root.widget-width;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Background color");
                        description: @tr("Empty uses the theme's panel color.");
                        ColorField {
                            text <=> root.widget-background;
                            swatch: root.widget-background-swatch;
                            fallback: root.widget-background-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Background opacity");
                        description: "\{Math.round(root.widget-opacity)}%";
                        Slider {
                            width: 200px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.widget-opacity;
                            changed => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Items"); }
                Card {
                    SettingRow {
                        title: @tr("Choose items");
                        description: @tr("Off shows the same items as the taskbar. To reorder, drag a handle here or Shift+drag an item on the widget.");
                        Switch {
                            checked <=> root.widget-own-items;
                            toggled => { root.changed(); }
                        }
                    }
                    for row[i] in root.widget-items: widget-item-row := VerticalLayout {
                            property <int> drop-side: RowDrag.list == 2 && RowDrag.pointer-y >= self.absolute-position.y && RowDrag.pointer-y < self.absolute-position.y + self.height
                                ? (RowDrag.pointer-y > self.absolute-position.y + self.height / 2 ? 2 : 1) : 0;
                            changed drop-side => {
                                if (self.drop-side != 0) {
                                    RowDrag.over = i;
                                    RowDrag.after = self.drop-side == 2;
                                }
                            }
                        Divider { }
                        SettingRow {
                            title: row.name;
                            single-line-title: true;
                            DragHandle {
                                started(y) => {
                                    RowDrag.from = i;
                                    RowDrag.over = i;
                                    RowDrag.after = false;
                                    RowDrag.pointer-y = y;
                                    RowDrag.list = 2;
                                }
                                dragged(y) => { RowDrag.pointer-y = y; }
                                released => {
                                    RowDrag.list = 0;
                                    root.drop-widget-item(RowDrag.from, RowDrag.over, RowDrag.after);
                                }
                            }
                            ComboBox {
                                width: 130px;
                                model: row.is-cpu ? root.cpu-widget-item-styles : root.widget-item-styles;
                                current-index: row.style;
                                selected => { root.widget-item-choice(i, 0, self.current-index); }
                            }
                            ComboBox {
                                width: 130px;
                                model: root.widget-item-details;
                                current-index: row.detail;
                                selected => { root.widget-item-choice(i, 1, self.current-index); }
                            }
                            Switch {
                                enabled: root.widget-own-items;
                                checked: row.checked;
                                toggled => { root.widget-item-toggled(i, self.checked); }
                            }
                        }
                        // Sized zero, so the row's layout does not measure what it draws.
                        Rectangle {
                            height: 0;
                            Rectangle {
                                visible: RowDrag.list == 2 && RowDrag.from == i;
                                y: -widget-item-row.height;
                                height: widget-item-row.height;
                                background: Palette.foreground.transparentize(0.92);
                            }
                            Rectangle {
                                visible: RowDrag.list == 2 && RowDrag.over == i && RowDrag.from != i;
                                y: RowDrag.after ? -2px : -widget-item-row.height;
                                height: 2px;
                                background: Palette.accent-background;
                            }
                        }
                    }
                }
            }

            if root.tab == 5: Page {
                title: @tr("Sensors");
                SectionTitle { text: @tr("Temperatures and power"); }
                Card {
                    SettingRow {
                        title: @tr("Sensor service");
                        description: @tr("CPU temperature, CPU power and chipset temperature come from the optional Pulsar sensor service and the PawnIO driver, both of which need administrator rights. Run the Pulsar installer again to add them. Intel CPUs, and AMD Ryzen from Zen onwards; chipset temperature on Intel only. Without them, CPU power and temperature come from Windows where the PC publishes them. Frame rate needs the service but not PawnIO.");
                        Button {
                            text: @tr("About PawnIO");
                            clicked => { root.open-link("https://pawnio.eu"); }
                        }
                    }
                }
                SectionTitle { text: @tr("Frame rate"); }
                Card {
                    SettingRow {
                        title: @tr("Measure");
                        description: @tr("The app in front counts the frames it draws, on whichever monitor it is. A monitor counts how often its picture changes, whichever apps draw it.");
                        ComboBox {
                            width: 260px;
                            model: root.frame-monitors;
                            current-index <=> root.frame-monitor-index;
                            selected => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Games"); }
                Card {
                    SettingRow {
                        title: @tr("Show the strip in games");
                        description: @tr("While a game is in front, the frame rate and your taskbar items appear in the top-left corner of its monitor. Borderless and windowed games only.");
                        Switch {
                            checked <=> root.game-strip;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Summary when a game closes");
                        description: @tr("A notification with the time played, frame rate and peak temperatures, also saved to sessions.csv in the logs folder.");
                        Switch {
                            checked <=> root.game-summary;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Which apps are games");
                        description: @tr("The games Windows recognises, as Game Bar does. To change that for an app, bring it to the front, then right-click Pulsar and use Count as a game.");
                    }
                }
                SectionTitle { text: @tr("Units"); }
                Card {
                    SettingRow {
                        title: @tr("Temperature");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Celsius (°C)"), @tr("Fahrenheit (°F)")];
                            current-index <=> root.temperature-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Memory use");
                        description: @tr("For the memory and GPU memory items. Their graphs and colors still follow how full the memory is.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Percent used"), @tr("Amount used")];
                            current-index <=> root.memory-unit;
                            selected => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 6: Page {
                title: @tr("Devices");
                SectionTitle { text: @tr("Disk"); }
                Card {
                    SettingRow {
                        title: @tr("Disks");
                        description: @tr("One combined cell, or a cell per drive.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("All disks combined"), @tr("Each drive")];
                            current-index: root.per-drive ? 1 : 0;
                            // Picking an entry drops the binding above.
                            property <bool> wanted: root.per-drive;
                            changed wanted => { self.current-index = self.wanted ? 1 : 0; }
                            selected => {
                                root.per-drive = self.current-index == 1;
                                root.per-drive-selected();
                            }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drives");
                        for drive[i] in root.drive-rows: CheckBox {
                            text: drive.letter + ":";
                            checked: drive.checked;
                            toggled => { root.drive-toggled(i, self.checked); }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drive value");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Activity"), @tr("Used space")];
                            current-index: root.drive-used ? 1 : 0;
                            property <bool> wanted: root.drive-used;
                            changed wanted => { self.current-index = self.wanted ? 1 : 0; }
                            selected => {
                                root.drive-used = self.current-index == 1;
                                root.changed();
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Graphics"); }
                Card {
                    SettingRow {
                        title: @tr("GPUs");
                        description: @tr("One combined cell, or a cell per GPU. GPU temperature follows.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("All GPUs combined"), @tr("Each GPU")];
                            current-index: root.per-gpu ? 1 : 0;
                            property <bool> wanted: root.per-gpu;
                            changed wanted => { self.current-index = self.wanted ? 1 : 0; }
                            selected => {
                                root.per-gpu = self.current-index == 1;
                                root.per-gpu-selected();
                            }
                        }
                    }
                    if root.per-gpu: Divider { }
                    if root.per-gpu: SettingRow {
                        title: @tr("Cards");
                        VerticalLayout {
                            spacing: 4px;
                            for gpu[i] in root.gpu-rows: CheckBox {
                                text: gpu.label;
                                checked: gpu.checked;
                                toggled => { root.gpu-toggled(i, self.checked); }
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Network"); }
                Card {
                    SettingRow {
                        title: @tr("Traffic");
                        description: @tr("Every physical adapter combined, or only the ones you tick. Several get a cell each.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("All hardware adapters"), @tr("Chosen adapters")];
                            current-index: root.per-adapter ? 1 : 0;
                            property <bool> wanted: root.per-adapter;
                            changed wanted => { self.current-index = self.wanted ? 1 : 0; }
                            selected => {
                                root.per-adapter = self.current-index == 1;
                                root.per-adapter-selected();
                            }
                        }
                    }
                    if root.per-adapter: Divider { }
                    if root.per-adapter: SettingRow {
                        title: @tr("Adapters");
                        VerticalLayout {
                            spacing: 4px;
                            for adapter[i] in root.adapter-rows: CheckBox {
                                text: adapter.label;
                                checked: adapter.checked;
                                toggled => { root.adapter-toggled(i, self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Show");
                        description: @tr("The rates shown on the taskbar.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Download and upload"), @tr("Download only"), @tr("Upload only")];
                            current-index <=> root.network-show;
                            selected => { root.changed(); }
                        }
                    }
                    if root.mode == 0 && root.network-show == 0: Divider { }
                    OptionalRow {
                        shown: root.mode == 0 && root.network-show == 0;
                        title: @tr("Separate tiles");
                        description: @tr("Give download and upload a graph tile each. A wider overlay can cover taskbar buttons.");
                        Switch {
                            checked <=> root.network-split-tiles;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Show in popup");
                        description: @tr("The rates shown in the network popup, whatever the taskbar shows.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Download and upload"), @tr("Download only"), @tr("Upload only")];
                            current-index <=> root.network-popup-show;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Download label");
                        description: root.labels == 2 ? @tr("Labels are off on the Layout page, so this doesn't show.")
                            : @tr("Replaces the arrow on the overlay, up to 12 characters. With several adapters, each adds its number.");
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 140px;
                                enabled: root.labels != 2;
                                placeholder-text: "↓";
                                text <=> root.network-down-label;
                                edited(text) => {
                                    let limited = root.limit-label(text);
                                    if (limited != text) {
                                        self.text = limited;
                                    }
                                    root.changed();
                                }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Upload label");
                        description: root.labels == 2 ? @tr("Labels are off on the Layout page, so this doesn't show.")
                            : @tr("Replaces the arrow on the overlay, up to 12 characters. With several adapters, each adds its number.");
                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 140px;
                                enabled: root.labels != 2;
                                placeholder-text: "↑";
                                text <=> root.network-up-label;
                                edited(text) => {
                                    let limited = root.limit-label(text);
                                    if (limited != text) {
                                        self.text = limited;
                                    }
                                    root.changed();
                                }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Minimum download speed");
                        description: @tr("Below this, the taskbar and widget show 0. Details and recordings keep the real rate.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 1000000000;
                            value <=> root.min-down;
                            edited => { root.changed(); }
                        }
                        ComboBox {
                            width: 90px;
                            model: root.network-floor-units;
                            current-index <=> root.min-down-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Minimum upload speed");
                        description: @tr("Below this, the taskbar and widget show 0. Details and recordings keep the real rate.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 1000000000;
                            value <=> root.min-up;
                            edited => { root.changed(); }
                        }
                        ComboBox {
                            width: 90px;
                            model: root.network-floor-units;
                            current-index <=> root.min-up-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Network rates");
                        description: @tr("Disk speeds stay in bytes.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Bytes per second (MB/s)"), @tr("Bits per second (Mbps)")];
                            current-index <=> root.network-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Upload on top");
                        description: @tr("Show the upload rate above the download rate.");
                        Switch {
                            checked <=> root.upload-on-top;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Ping"); }
                Card {
                    SettingRow {
                        title: @tr("Host");
                        description: @tr("An IPv4 address or a name.");
                        LineEdit {
                            width: 200px;
                            text <=> root.ping-host;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Interval");
                        description: @tr("Milliseconds between pings.");
                        SpinBox {
                            width: 140px;
                            minimum: 1000;
                            maximum: 60000;
                            step-size: 500;
                            value <=> root.ping-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 7: Page {
                title: @tr("General");
                Card {
                    SettingRow {
                        title: @tr("Language");
                        description: @tr("For Pulsar's windows, menus and labels.");
                        ComboBox {
                            width: 200px;
                            model: root.languages;
                            current-index <=> root.language-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Start with Windows");
                        description: @tr("Launch Pulsar when you sign in.");
                        Switch {
                            checked <=> root.autostart;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Check for updates");
                        description: @tr("Look for a new release once a day. Nothing is downloaded automatically.");
                        Switch {
                            checked <=> root.update-check;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray icon");
                        description: @tr("Show Pulsar in the notification area. When hidden, right-click the overlay for the menu, or start Pulsar again to open Settings.");
                        Switch {
                            checked <=> root.tray-icon;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Shortcuts"); }
                Card {
                    SettingRow {
                        title: @tr("Keyboard shortcuts");
                        description: @tr("Select a box and press the keys, with Ctrl, Alt or Win. Backspace clears it. They work anywhere in Windows.");
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Show or hide Pulsar");
                        HotkeyField {
                            text: root.hotkey-show-hide;
                            pressed(event) => {
                                root.hotkey-pressed(0, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Turn the desktop widget on or off");
                        HotkeyField {
                            text: root.hotkey-widget;
                            pressed(event) => {
                                root.hotkey-pressed(1, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Open system details");
                        HotkeyField {
                            text: root.hotkey-details;
                            pressed(event) => {
                                root.hotkey-pressed(2, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Start or stop recording to CSV");
                        HotkeyField {
                            text: root.hotkey-record;
                            pressed(event) => {
                                root.hotkey-pressed(3, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Switch to the next profile");
                        HotkeyField {
                            text: root.hotkey-next-profile;
                            pressed(event) => {
                                root.hotkey-pressed(4, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Alerts"); }
                Card {
                    SettingRow {
                        title: root.alert-fahrenheit ? @tr("CPU temperature (°F)") : @tr("CPU temperature (°C)");
                        description: @tr("When it stays at or above this for half a minute. Needs the sensor service.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-cpu;
                            minimum: root.alert-fahrenheit ? 122 : 50;
                            maximum: root.alert-fahrenheit ? 230 : 110;
                            value <=> root.alert-cpu-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-cpu;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: root.alert-fahrenheit ? @tr("GPU temperature (°F)") : @tr("GPU temperature (°C)");
                        description: @tr("When it stays at or above this for half a minute.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-gpu;
                            minimum: root.alert-fahrenheit ? 122 : 50;
                            maximum: root.alert-fahrenheit ? 230 : 110;
                            value <=> root.alert-gpu-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-gpu;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Battery charge (%)");
                        description: @tr("When it falls to this on battery power.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-battery;
                            minimum: 5;
                            maximum: 50;
                            value <=> root.alert-battery-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-battery;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Drive free space (%)");
                        description: @tr("When any drive falls to this.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-drives;
                            minimum: 1;
                            maximum: 50;
                            value <=> root.alert-drives-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-drives;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Sampling"); }
                Card {
                    SettingRow {
                        title: @tr("Update interval");
                        description: @tr("Milliseconds between readings.");
                        SpinBox {
                            width: 140px;
                            minimum: 500;
                            maximum: 5000;
                            step-size: 250;
                            value <=> root.sample-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Update interval on battery");
                        description: @tr("Milliseconds between readings while unplugged. Off keeps the interval above.");
                        SpinBox {
                            width: 140px;
                            enabled: root.battery-interval-on;
                            minimum: 500;
                            maximum: 5000;
                            step-size: 250;
                            value <=> root.battery-interval-ms;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.battery-interval-on;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("History length");
                        description: @tr("Readings kept for the graphs.");
                        SpinBox {
                            width: 140px;
                            minimum: 10;
                            maximum: 600;
                            step-size: 10;
                            value <=> root.history-len;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Reset"); }
                Card {
                    SettingRow {
                        title: @tr("Reset all settings");
                        description: root.confirm-reset ? @tr("Everything except Start with Windows and the language goes back to its default.") : @tr("Start over with the default look and items.");
                        if !root.confirm-reset: Button {
                            text: @tr("Reset…");
                            clicked => { root.confirm-reset = true; }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Reset");
                            primary: true;
                            clicked => {
                                root.confirm-reset = false;
                                root.reset-all();
                            }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-reset = false; }
                        }
                    }
                }
            }

            if root.tab == 9: Page {
                title: @tr("Profiles");
                Text {
                    text: @tr("A profile keeps what the overlay and widget show and how they look: items, layout, theme, popups, widget, units, drives and network. Language, startup, update interval, games, alerts and shortcuts stay the same in every profile. Switch profiles here or from the Profiles menu.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Save as a profile");
                        description: root.profile-status != "" ? root.profile-status : @tr("Keeps the current settings under a name. Saving with a profile's name again updates it.");
                        LineEdit {
                            width: 160px;
                            placeholder-text: @tr("Name");
                            text <=> root.profile-name;
                        }
                        Button {
                            text: @tr("Save");
                            enabled: root.profile-name != "";
                            clicked => {
                                root.save-profile(root.profile-name);
                                root.profile-name = "";
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Profiles folder");
                        description: @tr("Profile files to back up or share.");
                        Button {
                            text: @tr("Open");
                            clicked => { root.open-profiles-folder(); }
                        }
                    }
                }
                if root.profiles.length > 0: SectionTitle { text: @tr("Saved profiles"); }
                if root.profiles.length > 0: Card {
                    for profile[i] in root.profiles: VerticalLayout {
                        if i > 0: Divider { }
                        SettingRow {
                            title: profile.name;
                            description: profile.active ? @tr("Current") : "";
                            Button {
                                text: @tr("Apply");
                                enabled: !profile.active;
                                clicked => { root.apply-profile(i); }
                            }
                            Button {
                                text: @tr("Delete");
                                clicked => { root.delete-profile(i); }
                            }
                        }
                    }
                }
            }

            if root.tab == 8: Page {
                title: @tr("About");
                Card {
                    HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Image {
                            source: @image-url("../assets/pulsar-64.png");
                            width: 48px;
                            height: 48px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: @tr("Pulsar {}", root.version);
                                font-size: 20px;
                                font-weight: 600;
                            }
                            Text {
                                text: @tr("A Windows 11 taskbar system monitor.");
                                color: Palette.foreground.transparentize(0.35);
                            }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("Updates");
                        description: root.update-status != "" ? root.update-status : @tr("Ask GitHub for the latest release now. Nothing is downloaded.");
                        Button {
                            text: @tr("Check now");
                            enabled: !root.update-checking;
                            clicked => { root.check-for-update(); }
                        }
                    }
                    Divider { height: root.update-url != "" ? 1px : 0; }
                    OptionalRow {
                        shown: root.update-url != "";
                        title: @tr("Release page");
                        description: root.update-url;
                        Button {
                            text: @tr("Open release page");
                            clicked => { root.open-link(root.update-url); }
                        }
                    }
                    Divider { height: root.update-notes != "" ? 1px : 0; }
                    OptionalRow {
                        shown: root.update-notes != "";
                        title: @tr("What's new");
                        description: root.update-notes;
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("License");
                        description: @tr("GNU General Public License v3.0 or later. Built with Slint.");
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Settings file");
                        description: root.config-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-config-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Logs");
                        description: root.logs-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-logs-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Diagnostics");
                        description: root.diagnostics-status != "" ? root.diagnostics-status : @tr("Save every reading Pulsar can take to a text file in the logs folder, to attach to an issue. It lists process and network adapter names; read it before sharing.");
                        Button {
                            text: @tr("Save report");
                            clicked => { root.save-diagnostics(); }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("Source code");
                        description: root.repo-url;
                        Button {
                            text: @tr("Open on GitHub");
                            clicked => { root.open-link(root.repo-url); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Report a problem");
                        description: @tr("Attach pulsar.log, and any crash report, from the logs folder.");
                        Button {
                            text: @tr("Report an issue");
                            clicked => { root.open-link(root.issues-url); }
                        }
                    }
                }
            }
    }
}
