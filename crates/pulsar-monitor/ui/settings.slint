import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";

export struct ItemRow {
    name: string,
    enabled: bool,
    color: string,
    swatch: color,
    // Indexes into the styles, colour-modes and item-popup-details lists.
    style: int,
    color-mode: int,
    popup: int,
    expanded: bool,
}

export struct DriveRow {
    letter: string,
    checked: bool,
}

// Glyphs from the Segoe Fluent Icons font that ships with Windows 11.
global Icons {
    out property <string> settings: "\u{E713}";
    out property <string> display: "\u{E7F4}";
    out property <string> list: "\u{EA37}";
    out property <string> info: "\u{E946}";
    out property <string> up: "\u{E70E}";
    out property <string> down: "\u{E70D}";
    out property <string> folder: "\u{E8B7}";
    out property <string> chart: "\u{E9D9}";
    out property <string> options: "\u{E713}";
}

component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Palette.foreground.transparentize(0.9) : transparent;
    Icon {
        text: root.icon;
        font-size: 12px;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(0.7);
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Palette.alternate-background : touch.has-hover ? Palette.alternate-background.transparentize(0.5) : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 16px : 0;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Icon {
            text: root.icon;
            width: 20px;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A setting: title and description on the left, its control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.35);
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        horizontal-stretch: 0;
        spacing: 8px;
        @children
    }
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border.transparentize(0.6);
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border.transparentize(0.7);
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
}

export global ColorUtil {
    in property <[color]> swatches;
    pure callback hex(color) -> string;
}

component Swatch inherits Rectangle {
    in property <color> value;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.value;
}

component HueBar inherits Rectangle {
    in-out property <float> hue;
    callback edited();
    height: 14px;
    border-radius: 7px;
    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
    function pick(x: length) {
        root.hue = Math.clamp(x / root.width, 0, 1) * 359.9;
        root.edited();
    }
    Rectangle {
        x: root.hue / 360 * root.width - self.width / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, 1, 1);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// Saturation left to right, brightness top to bottom.
component SaturationValueArea inherits Rectangle {
    in property <float> hue;
    in-out property <float> saturation;
    in-out property <float> value;
    callback edited();
    border-radius: 6px;
    background: hsv(root.hue, 1, 1);
    function pick(x: length, y: length) {
        root.saturation = Math.clamp(x / root.width, 0, 1);
        root.value = 1 - Math.clamp(y / root.height, 0, 1);
        root.edited();
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
    }
    Rectangle {
        x: root.saturation * root.width - self.width / 2;
        y: (1 - root.value) * root.height - self.height / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, root.saturation, root.value);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x, self.mouse-y);
            }
        }
        moved => { root.pick(self.mouse-x, self.mouse-y); }
    }
}

// A colour setting: a swatch that opens a picker, and the hex text.
component ColorField inherits HorizontalLayout {
    in-out property <string> text;
    // Transparent when the text is empty or half-typed.
    in property <color> swatch;
    // Where the picker starts when there is no valid colour.
    in property <color> fallback;
    in property <string> placeholder: "#RRGGBB";
    in property <length> field-width: 140px;
    // Typed or picked; empty means the default.
    callback edited(string);
    property <float> hue;
    property <float> saturation;
    property <float> value;
    spacing: 8px;

    function set(hex: string) {
        root.text = hex;
        root.edited(hex);
    }
    function picked() {
        root.set(ColorUtil.hex(hsv(root.hue, root.saturation, root.value)));
    }
    function start-from(c: color) {
        let h = c.to-hsv();
        root.hue = h.hue;
        root.saturation = h.saturation;
        root.value = h.value;
    }

    swatch-button := Rectangle {
        width: 28px;
        height: 28px;
        Swatch {
            value: root.swatch;
            border-color: touch.has-hover ? Palette.accent-background : Palette.border;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.start-from(root.swatch.to-hsv().alpha > 0 ? root.swatch : root.fallback);
                picker.show();
            }
        }
    }
    LineEdit {
        width: root.field-width;
        placeholder-text: root.placeholder;
        text <=> root.text;
        edited(text) => { root.edited(text); }
    }

    picker := PopupWindow {
        x: swatch-button.x + swatch-button.width - self.width;
        y: swatch-button.y + swatch-button.height + 6px;
        width: 268px;
        height: content.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
        }
        content := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            SaturationValueArea {
                height: 150px;
                hue: root.hue;
                saturation <=> root.saturation;
                value <=> root.value;
                edited => { root.picked(); }
            }
            HueBar {
                hue <=> root.hue;
                edited => { root.picked(); }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for c in ColorUtil.swatches: Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: preset-touch.has-hover ? Palette.accent-background : Palette.border;
                    background: c;
                    preset-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.start-from(c);
                            root.picked();
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Swatch {
                    value: hsv(root.hue, root.saturation, root.value);
                }
                Text {
                    text: root.text == "" ? @tr("Default") : root.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Use default");
                    enabled: root.text != "";
                    clicked => {
                        root.set("");
                        picker.close();
                    }
                }
            }
        }
    }
}

component Page inherits VerticalLayout {
    in property <string> title;
    padding: 28px;
    padding-top: 20px;
    spacing: 12px;
    alignment: start;
    Text {
        text: root.title;
        font-size: 28px;
        font-weight: 600;
    }
    @children
}

export component SettingsWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    icon: @image-url("../assets/pulsar-64.png");
    preferred-width: 820px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 480px;
    background: Palette.background;
    // Read by the app to colour the native title bar to match.
    out property <brush> backdrop: Palette.background;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Set per language by the app.
    in property <string> ui-font: "Segoe UI Variable Text";
    default-font-family: root.ui-font;

    in-out property <int> tab;
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> tray-icon;
    in-out property <int> sample-interval-ms;
    in-out property <int> history-len;
    in-out property <int> mode;
    in-out property <bool> graph-inline;
    in-out property <bool> hover-popup;
    in-out property <int> position;
    in-out property <int> offset-px;
    in-out property <int> fallback-margin-px;
    in-out property <int> font-size-pt;
    in-out property <bool> show-on-all-taskbars;
    in-out property <bool> accent-graphs;
    in-out property <string> tile-color;
    in property <color> tile-swatch;
    in property <color> tile-default;
    in-out property <bool> tile-opacity-custom;
    in-out property <float> tile-opacity;
    in-out property <string> panel-color;
    in property <color> panel-swatch;
    in property <color> panel-default;
    in-out property <float> panel-opacity;
    in-out property <[ItemRow]> items;
    in-out property <string> ping-host;
    in-out property <int> ping-interval-ms;
    in property <string> version;
    in property <string> config-path;
    in property <string> logs-path;
    in property <string> repo-url;
    in property <string> issues-url;
    in-out property <int> labels;
    in-out property <bool> icons;
    in-out property <bool> hide-in-fullscreen;
    in-out property <bool> lock-position;
    in-out property <string> label-color;
    in property <color> label-swatch;
    in property <color> label-default;
    in-out property <string> value-color;
    in property <color> value-swatch;
    in property <color> value-default;
    in-out property <string> label-color-light;
    in property <color> label-light-swatch;
    in-out property <string> value-color-light;
    in property <color> value-light-swatch;
    in-out property <bool> color-labels;
    in-out property <int> temperature-unit;
    in-out property <int> network-unit;
    in-out property <bool> upload-on-top;
    in-out property <int> popup-detail;
    in-out property <bool> popup-graph;
    in-out property <bool> popup-translucent;
    in-out property <int> popup-processes;
    in property <[string]> styles;
    in property <[string]> color-modes;
    in property <[string]> popup-details;
    in property <[string]> item-popup-details;
    in property <string> diagnostics-status;
    in property <[string]> fonts;
    in-out property <int> font-index;
    in-out property <bool> font-bold;
    in property <[string]> presets;
    in-out property <int> preset-index;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[string]> adapters;
    in-out property <int> adapter-index;
    in-out property <[DriveRow]> drive-rows;
    in-out property <bool> per-drive;
    in-out property <bool> drive-used;
    property <bool> confirm-reset;

    // Any edit; the app saves shortly after the last one.
    callback changed();
    callback item-enabled(int, bool);
    callback item-color(int, string);
    // Row, field (0 style, 1 colour mode, 2 popup) and the chosen index.
    callback item-choice(int, int, int);
    callback item-expanded(int, bool);
    callback move-item(int, bool);
    callback save-diagnostics();
    callback open-config-folder();
    callback open-logs-folder();
    callback open-link(string);
    callback apply-preset(int);
    callback reset-all();
    callback reset-position();
    callback drive-toggled(int, bool);
    callback per-drive-selected();

    HorizontalLayout {
        // Navigation
        VerticalLayout {
            width: 230px;
            padding: 12px;
            padding-top: 8px;
            spacing: 4px;
            NavItem {
                icon: Icons.settings;
                label: @tr("General");
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            NavItem {
                icon: Icons.display;
                label: @tr("Display");
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
            NavItem {
                icon: Icons.list;
                label: @tr("Items");
                selected: root.tab == 2;
                clicked => { root.tab = 2; }
            }
            NavItem {
                icon: Icons.info;
                label: @tr("About");
                selected: root.tab == 3;
                clicked => { root.tab = 3; }
            }
            Rectangle { }
        }

        // Content
        // A layout inside gives the scroll view its content height.
        scroll := ScrollView {
          VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            if root.tab == 0: Page {
                title: @tr("General");
                Card {
                    SettingRow {
                        title: @tr("Language");
                        description: @tr("For Pulsar's windows, menus and labels.");
                        ComboBox {
                            width: 200px;
                            model: root.languages;
                            current-index <=> root.language-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Start with Windows");
                        description: @tr("Launch Pulsar when you sign in.");
                        Switch {
                            checked <=> root.autostart;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Check for updates");
                        description: @tr("Look for a new release once a day. Nothing is downloaded automatically.");
                        Switch {
                            checked <=> root.update-check;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray icon");
                        description: @tr("Show Pulsar in the notification area. When hidden, right-click the overlay for the menu, or start Pulsar again to open Settings.");
                        Switch {
                            checked <=> root.tray-icon;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Sampling"); }
                Card {
                    SettingRow {
                        title: @tr("Update interval");
                        description: @tr("Milliseconds between readings.");
                        SpinBox {
                            width: 140px;
                            minimum: 500;
                            maximum: 5000;
                            step-size: 250;
                            value <=> root.sample-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("History length");
                        description: @tr("Readings kept for the graphs.");
                        SpinBox {
                            width: 140px;
                            minimum: 10;
                            maximum: 600;
                            step-size: 10;
                            value <=> root.history-len;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Reset"); }
                Card {
                    SettingRow {
                        title: @tr("Reset all settings");
                        description: root.confirm-reset ? @tr("Everything except Start with Windows and the language goes back to its default.") : @tr("Start over with the default look and items.");
                        if !root.confirm-reset: Button {
                            text: @tr("Reset…");
                            clicked => { root.confirm-reset = true; }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Reset");
                            primary: true;
                            clicked => {
                                root.confirm-reset = false;
                                root.reset-all();
                            }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-reset = false; }
                        }
                    }
                }
            }

            if root.tab == 1: Page {
                title: @tr("Display");
                Card {
                    SettingRow {
                        title: @tr("Mode");
                        description: @tr("Graphs, or compact text only.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Graphs"), @tr("Text only")];
                            current-index <=> root.mode;
                            selected => { root.changed(); }
                        }
                    }
                    if root.mode == 0: Divider { }
                    if root.mode == 0: SettingRow {
                        title: @tr("Single-line graphs");
                        description: @tr("Put the icon, label and value on one line, for short taskbars.");
                        Switch {
                            checked <=> root.graph-inline;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Labels");
                        description: @tr("Full names, one letter per item (C, H, W, M, G, T, D, P), or none with icons alone.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Full"), @tr("Short"), @tr("None (icons only)")];
                            current-index <=> root.labels;
                            selected => {
                                if (root.labels == 2) {
                                    root.icons = true;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Icons");
                        description: @tr("An icon before each label, or on its own.");
                        Switch {
                            checked <=> root.icons;
                            toggled => {
                                if (!self.checked && root.labels == 2) {
                                    root.labels = 0;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Hide in fullscreen");
                        description: @tr("Fade out while a fullscreen game or video is in front.");
                        Switch {
                            checked <=> root.hide-in-fullscreen;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Text"); }
                Card {
                    SettingRow {
                        title: @tr("Font");
                        description: @tr("Fonts without fixed-width digits may shift slightly as values change.");
                        ComboBox {
                            width: 220px;
                            model: root.fonts;
                            current-index <=> root.font-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Bold");
                        Switch {
                            checked <=> root.font-bold;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Font size");
                        description: @tr("Points.");
                        SpinBox {
                            width: 140px;
                            minimum: 6;
                            maximum: 20;
                            value <=> root.font-size-pt;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Accent colour graphs");
                        description: @tr("Draw graphs in your Windows accent colour.");
                        Switch {
                            checked <=> root.accent-graphs;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Colours"); }
                Card {
                    SettingRow {
                        title: @tr("Theme preset");
                        description: @tr("Sets item, label, value, tile and panel colours at once.");
                        ComboBox {
                            width: 180px;
                            model: root.presets;
                            current-index <=> root.preset-index;
                        }
                        Button {
                            text: @tr("Apply");
                            clicked => { root.apply-preset(root.preset-index); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Label colour");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.label-color;
                            swatch: root.label-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value colour");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.value-color;
                            swatch: root.value-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Label colour on a light taskbar");
                        description: @tr("Empty uses the label colour above.");
                        ColorField {
                            text <=> root.label-color-light;
                            swatch: root.label-light-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value colour on a light taskbar");
                        description: @tr("Empty uses the value colour above.");
                        ColorField {
                            text <=> root.value-color-light;
                            swatch: root.value-light-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Colour labels by item");
                        description: @tr("Draw each label in its item's colour.");
                        Switch {
                            checked <=> root.color-labels;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Popups"); }
                Card {
                    SettingRow {
                        title: @tr("Details on hover");
                        description: @tr("Show a graph and details when the mouse rests on an item.");
                        Switch {
                            checked <=> root.hover-popup;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Detail");
                        description: @tr("Simple shows the value and its graph; Detailed adds everything Pulsar reads. Items can choose their own on the Items page.");
                        ComboBox {
                            width: 200px;
                            model: root.popup-details;
                            current-index <=> root.popup-detail;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Translucent background");
                        description: @tr("Blur what is behind the popup. If Windows does not allow it, popups stay solid.");
                        Switch {
                            checked <=> root.popup-translucent;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Graph");
                        description: @tr("The recent history at the top of each popup.");
                        Switch {
                            checked <=> root.popup-graph;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Top processes");
                        description: @tr("Processes listed for CPU, memory, GPU and disk; 0 hides the lists.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 15;
                            value <=> root.popup-processes;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Units"); }
                Card {
                    SettingRow {
                        title: @tr("Temperature");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Celsius (°C)"), @tr("Fahrenheit (°F)")];
                            current-index <=> root.temperature-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Network rates");
                        description: @tr("Disk speeds stay in bytes.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Bytes per second (MB/s)"), @tr("Bits per second (Mbps)")];
                            current-index <=> root.network-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Upload on top");
                        description: @tr("Show the upload rate above the download rate.");
                        Switch {
                            checked <=> root.upload-on-top;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Position"); }
                Card {
                    SettingRow {
                        title: @tr("Placement");
                        description: @tr("Where the overlay sits on the taskbar.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Next to the tray"), @tr("Left edge"), @tr("Floating")];
                            current-index <=> root.position;
                            selected => { root.changed(); }
                        }
                    }
                    if root.position == 2: Divider { }
                    if root.position == 2: SettingRow {
                        title: @tr("Lock position");
                        description: @tr("Drag the overlay to move it. Add a panel background so it stays readable over any window.");
                        Button {
                            text: @tr("Reset position");
                            clicked => { root.reset-position(); }
                        }
                        Switch {
                            checked <=> root.lock-position;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Offset");
                        description: @tr("Extra space in pixels, moving away from the anchor.");
                        SpinBox {
                            width: 140px;
                            minimum: -2000;
                            maximum: 2000;
                            step-size: 4;
                            value <=> root.offset-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray fallback margin");
                        description: @tr("Used when the tray position cannot be read.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 2000;
                            step-size: 10;
                            value <=> root.fallback-margin-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Every taskbar");
                        description: @tr("Also show on the taskbars of other monitors.");
                        Switch {
                            checked <=> root.show-on-all-taskbars;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Background"); }
                Card {
                    SettingRow {
                        title: @tr("Tile colour");
                        description: @tr("Empty uses the theme tint.");
                        ColorField {
                            text <=> root.tile-color;
                            swatch: root.tile-swatch;
                            fallback: root.tile-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Custom tile opacity");
                        description: root.tile-opacity-custom ? @tr("{}% — 0% removes the tiles.", Math.round(root.tile-opacity)) : @tr("Using the theme default.");
                        Slider {
                            width: 160px;
                            enabled: root.tile-opacity-custom;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.tile-opacity;
                            changed => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.tile-opacity-custom;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Panel colour");
                        description: @tr("A panel behind the whole overlay. Empty uses the theme.");
                        ColorField {
                            text <=> root.panel-color;
                            swatch: root.panel-swatch;
                            fallback: root.panel-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Panel opacity");
                        description: root.panel-opacity > 0 ? "\{Math.round(root.panel-opacity)}%" : @tr("Off");
                        Slider {
                            width: 200px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.panel-opacity;
                            changed => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 2: Page {
                title: @tr("Items");
                Text {
                    text: @tr("Choose what the overlay shows, its order, and each item's colour (empty uses the default). Open an item's options for its graph style, colouring and popup. Right-click an item on the taskbar for the same options.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    for row[i] in root.items: VerticalLayout {
                        if i > 0: Divider { }
                        SettingRow {
                            title: row.name;
                            IconButton {
                                icon: Icons.options;
                                clicked => { root.item-expanded(i, !row.expanded); }
                            }
                            ColorField {
                                text: row.color;
                                swatch: row.swatch;
                                fallback: row.swatch;
                                placeholder: @tr("Default");
                                field-width: 120px;
                                edited(text) => { root.item-color(i, text); }
                            }
                            IconButton {
                                icon: Icons.up;
                                enabled: i > 0;
                                clicked => { root.move-item(i, true); }
                            }
                            IconButton {
                                icon: Icons.down;
                                enabled: i < root.items.length - 1;
                                clicked => { root.move-item(i, false); }
                            }
                            Switch {
                                checked: row.enabled;
                                toggled => { root.item-enabled(i, self.checked); }
                            }
                        }
                        if row.expanded: VerticalLayout {
                            padding-left: 24px;
                            padding-bottom: 4px;
                            if root.mode == 0: SettingRow {
                                title: @tr("Graph style");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.styles;
                                    current-index: row.style;
                                    selected => { root.item-choice(i, 0, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Colour");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.color-modes;
                                    current-index: row.color-mode;
                                    selected => { root.item-choice(i, 1, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Popup detail");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.item-popup-details;
                                    current-index: row.popup;
                                    selected => { root.item-choice(i, 2, self.current-index); }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: @tr("Colour by load turns an item green, yellow, orange or red as its value rises: from 50, 75 and 90 %, 70, 80 and 90 °C, and 50, 100 and 200 ms for ping. Other values keep the item colour.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                SectionTitle { text: @tr("Temperatures and power"); }
                Card {
                    SettingRow {
                        title: @tr("Sensor service");
                        description: @tr("CPU temperature, CPU power and chipset temperature need the optional Pulsar sensor service and the PawnIO driver, both of which need administrator rights. Run the Pulsar installer again to add them. Intel CPUs, and AMD Ryzen from Zen onwards; chipset temperature on Intel only.");
                        Button {
                            text: @tr("About PawnIO");
                            clicked => { root.open-link("https://pawnio.eu"); }
                        }
                    }
                }
                SectionTitle { text: @tr("Disk"); }
                Card {
                    SettingRow {
                        title: @tr("Disks");
                        description: @tr("One combined cell, or a cell per drive.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("All disks combined"), @tr("Each drive")];
                            current-index: root.per-drive ? 1 : 0;
                            selected => {
                                root.per-drive = self.current-index == 1;
                                root.per-drive-selected();
                            }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drives");
                        for drive[i] in root.drive-rows: CheckBox {
                            text: drive.letter + ":";
                            checked: drive.checked;
                            toggled => { root.drive-toggled(i, self.checked); }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drive value");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Activity"), @tr("Used space")];
                            current-index: root.drive-used ? 1 : 0;
                            selected => {
                                root.drive-used = self.current-index == 1;
                                root.changed();
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Network"); }
                Card {
                    SettingRow {
                        title: @tr("Adapter");
                        description: @tr("Count one adapter, or every physical one.");
                        ComboBox {
                            width: 260px;
                            model: root.adapters;
                            current-index <=> root.adapter-index;
                            selected => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Ping"); }
                Card {
                    SettingRow {
                        title: @tr("Host");
                        description: @tr("An IPv4 address or a name.");
                        LineEdit {
                            width: 200px;
                            text <=> root.ping-host;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Interval");
                        description: @tr("Milliseconds between pings.");
                        SpinBox {
                            width: 140px;
                            minimum: 1000;
                            maximum: 60000;
                            step-size: 500;
                            value <=> root.ping-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 3: Page {
                title: @tr("About");
                Card {
                    HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Image {
                            source: @image-url("../assets/pulsar-64.png");
                            width: 48px;
                            height: 48px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: @tr("Pulsar {}", root.version);
                                font-size: 20px;
                                font-weight: 600;
                            }
                            Text {
                                text: @tr("A Windows 11 taskbar system monitor.");
                                color: Palette.foreground.transparentize(0.35);
                            }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("License");
                        description: @tr("GNU General Public License v3.0 or later. Built with Slint.");
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Settings file");
                        description: root.config-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-config-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Logs");
                        description: root.logs-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-logs-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Diagnostics");
                        description: root.diagnostics-status != "" ? root.diagnostics-status : @tr("Save every reading Pulsar can take to a text file in the logs folder, to attach to an issue. It lists process and network adapter names; read it before sharing.");
                        Button {
                            text: @tr("Save report");
                            clicked => { root.save-diagnostics(); }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("Source code");
                        description: root.repo-url;
                        Button {
                            text: @tr("Open on GitHub");
                            clicked => { root.open-link(root.repo-url); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Report a problem");
                        description: @tr("Attach pulsar.log, and any crash report, from the logs folder.");
                        Button {
                            text: @tr("Report an issue");
                            clicked => { root.open-link(root.issues-url); }
                        }
                    }
                }
            }
          }
        }
    }
}
