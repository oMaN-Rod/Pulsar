import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";

export struct ItemRow {
    name: string,
    enabled: bool,
    color: string,
    swatch: color,
    // Indexes into the styles, colour-modes and item-popup-details lists.
    style: int,
    color-mode: int,
    popup: int,
    expanded: bool,
}

// A theme picker card: its name and the colours its preview is drawn in.
export struct ThemeCard {
    name: string,
    taskbar: color,
    panel: color,
    tile: color,
    label: color,
    text: color,
    items: [color],
}

// Shows a shortcut, and records the next key pressed while it has focus.
component HotkeyField inherits Rectangle {
    in property <string> text;
    callback pressed(KeyEvent);
    width: 180px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: keys.has-focus ? Palette.accent-background : Palette.border;
    background: Palette.control-background;
    keys := FocusScope {
        key-pressed(event) => {
            root.pressed(event);
            accept
        }
    }
    TouchArea {
        clicked => { keys.focus(); }
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        vertical-alignment: center;
        overflow: elide;
        color: root.text == "" && !keys.has-focus ? Palette.control-foreground.transparentize(45%) : Palette.control-foreground;
        text: keys.has-focus ? @tr("Press keys…") : root.text == "" ? @tr("Not set") : root.text;
    }
}

export struct WidgetItemRow {
    name: string,
    checked: bool,
    // 0 follows the widget; otherwise one more than an index into the
    // style and detail lists.
    style: int,
    detail: int,
}

export struct DriveRow {
    letter: string,
    checked: bool,
}

// Glyphs from the Segoe Fluent Icons font that ships with Windows 11.
global Icons {
    out property <string> settings: "\u{E713}";
    out property <string> display: "\u{E7F4}";
    out property <string> list: "\u{EA37}";
    out property <string> info: "\u{E946}";
    out property <string> up: "\u{E70E}";
    out property <string> down: "\u{E70D}";
    out property <string> folder: "\u{E8B7}";
    out property <string> chart: "\u{E9D9}";
    out property <string> options: "\u{E713}";
    out property <string> palette: "\u{E790}";
    out property <string> popup: "\u{E8BD}";
    out property <string> sensor: "\u{E950}";
    out property <string> drive: "\u{EDA2}";
    out property <string> widget: "\u{ECA5}";
}

component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Palette.foreground.transparentize(0.9) : transparent;
    Icon {
        text: root.icon;
        font-size: 12px;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(0.7);
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Palette.alternate-background : touch.has-hover ? Palette.alternate-background.transparentize(0.5) : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 16px : 0;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Icon {
            text: root.icon;
            width: 20px;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A heading over a group of navigation items.
component NavGroup inherits Rectangle {
    in property <string> text;
    height: 30px;
    Text {
        x: 14px;
        y: parent.height - self.height - 4px;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Palette.foreground.transparentize(0.45);
    }
}

// A miniature overlay in the theme's colours: graph tiles with a label line
// and a value line on a strip of taskbar.
component ThemeTile inherits Rectangle {
    in property <ThemeCard> theme;
    in property <bool> selected;
    callback clicked();
    width: 136px;
    height: 100px;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 68px;
            border-radius: 8px;
            clip: true;
            background: root.theme.taskbar;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Palette.accent-background : touch.has-hover ? Palette.border : Palette.border.transparentize(0.5);
            Rectangle {
                x: 8px;
                y: 16px;
                width: parent.width - 16px;
                height: 36px;
                border-radius: 4px;
                background: root.theme.panel;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    for c[i] in root.theme.items: Rectangle {
                        background: root.theme.tile;
                        border-radius: 3px;
                        Rectangle {
                            x: 3px;
                            y: 3px;
                            width: parent.width * 0.55;
                            height: 3px;
                            border-radius: 1.5px;
                            background: root.theme.label;
                        }
                        Rectangle {
                            x: 3px;
                            y: 9px;
                            width: parent.width * 0.75;
                            height: 4px;
                            border-radius: 2px;
                            background: root.theme.text;
                        }
                        Rectangle {
                            property <float> level: [0.75, 0.45, 0.9, 0.6][i];
                            x: 0;
                            width: parent.width;
                            height: (parent.height - 16px) * self.level;
                            y: parent.height - self.height;
                            border-radius: 2px;
                            background: c.transparentize(0.25);
                        }
                    }
                }
            }
        }
        Text {
            text: root.theme.name;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Theme cards in as many columns as fit.
component ThemeGrid inherits Rectangle {
    in property <[ThemeCard]> themes;
    in property <int> selected;
    callback clicked(int);
    property <length> step-x: 136px + 12px;
    property <length> step-y: 100px + 10px;
    property <int> columns: Math.max(1, Math.floor((self.width + 12px) / self.step-x));
    min-height: Math.ceil(self.themes.length / self.columns) * self.step-y;
    for t[i] in root.themes: ThemeTile {
        x: Math.mod(i, root.columns) * root.step-x;
        y: Math.floor(i / root.columns) * root.step-y;
        theme: t;
        selected: i == root.selected;
        clicked => { root.clicked(i); }
    }
}

// A setting: title and description on the left, its control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.35);
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        horizontal-stretch: 0;
        spacing: 8px;
        @children
    }
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border.transparentize(0.6);
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border.transparentize(0.7);
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
}

export global ColorUtil {
    in property <[color]> swatches;
    pure callback hex(color) -> string;
}

component Swatch inherits Rectangle {
    in property <color> value;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.value;
}

component HueBar inherits Rectangle {
    in-out property <float> hue;
    callback edited();
    height: 14px;
    border-radius: 7px;
    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
    function pick(x: length) {
        root.hue = Math.clamp(x / root.width, 0, 1) * 359.9;
        root.edited();
    }
    Rectangle {
        x: root.hue / 360 * root.width - self.width / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, 1, 1);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// Saturation left to right, brightness top to bottom.
component SaturationValueArea inherits Rectangle {
    in property <float> hue;
    in-out property <float> saturation;
    in-out property <float> value;
    callback edited();
    border-radius: 6px;
    background: hsv(root.hue, 1, 1);
    function pick(x: length, y: length) {
        root.saturation = Math.clamp(x / root.width, 0, 1);
        root.value = 1 - Math.clamp(y / root.height, 0, 1);
        root.edited();
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
    }
    Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
    }
    Rectangle {
        x: root.saturation * root.width - self.width / 2;
        y: (1 - root.value) * root.height - self.height / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: white;
        background: hsv(root.hue, root.saturation, root.value);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000060;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(self.mouse-x, self.mouse-y);
            }
        }
        moved => { root.pick(self.mouse-x, self.mouse-y); }
    }
}

// A colour setting: a swatch that opens a picker, and the hex text.
component ColorField inherits HorizontalLayout {
    in-out property <string> text;
    // Transparent when the text is empty or half-typed.
    in property <color> swatch;
    // Where the picker starts when there is no valid colour.
    in property <color> fallback;
    in property <string> placeholder: "#RRGGBB";
    in property <length> field-width: 140px;
    // Typed or picked; empty means the default.
    callback edited(string);
    property <float> hue;
    property <float> saturation;
    property <float> value;
    spacing: 8px;

    function set(hex: string) {
        root.text = hex;
        root.edited(hex);
    }
    function picked() {
        root.set(ColorUtil.hex(hsv(root.hue, root.saturation, root.value)));
    }
    function start-from(c: color) {
        let h = c.to-hsv();
        root.hue = h.hue;
        root.saturation = h.saturation;
        root.value = h.value;
    }

    swatch-button := Rectangle {
        width: 28px;
        height: 28px;
        Swatch {
            value: root.swatch;
            border-color: touch.has-hover ? Palette.accent-background : Palette.border;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.start-from(root.swatch.to-hsv().alpha > 0 ? root.swatch : root.fallback);
                picker.show();
            }
        }
    }
    LineEdit {
        width: root.field-width;
        placeholder-text: root.placeholder;
        text <=> root.text;
        edited(text) => { root.edited(text); }
    }

    picker := PopupWindow {
        x: swatch-button.x + swatch-button.width - self.width;
        y: swatch-button.y + swatch-button.height + 6px;
        width: 268px;
        height: content.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
        }
        content := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            SaturationValueArea {
                height: 150px;
                hue: root.hue;
                saturation <=> root.saturation;
                value <=> root.value;
                edited => { root.picked(); }
            }
            HueBar {
                hue <=> root.hue;
                edited => { root.picked(); }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for c in ColorUtil.swatches: Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: preset-touch.has-hover ? Palette.accent-background : Palette.border;
                    background: c;
                    preset-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.start-from(c);
                            root.picked();
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Swatch {
                    value: hsv(root.hue, root.saturation, root.value);
                }
                Text {
                    text: root.text == "" ? @tr("Default") : root.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Use default");
                    enabled: root.text != "";
                    clicked => {
                        root.set("");
                        picker.close();
                    }
                }
            }
        }
    }
}

component Page inherits VerticalLayout {
    in property <string> title;
    padding: 28px;
    padding-top: 20px;
    spacing: 12px;
    alignment: start;
    Text {
        text: root.title;
        font-size: 28px;
        font-weight: 600;
    }
    @children
}

export component SettingsWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    icon: @image-url("../assets/pulsar-64.png");
    preferred-width: 820px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 480px;
    background: Palette.background;
    // Read by the app to colour the native title bar to match.
    out property <brush> backdrop: Palette.background;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Set per language by the app.
    in property <string> ui-font: "Segoe UI Variable Text";
    default-font-family: root.ui-font;

    in-out property <int> tab;
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> tray-icon;
    in-out property <int> sample-interval-ms;
    in-out property <int> history-len;
    in-out property <int> mode;
    in-out property <bool> graph-inline;
    in-out property <bool> hover-popup;
    in-out property <int> position;
    in-out property <int> offset-px;
    in-out property <int> fallback-margin-px;
    in-out property <int> font-size-pt;
    in-out property <bool> show-on-all-taskbars;
    in-out property <bool> accent-graphs;
    in-out property <string> tile-color;
    in property <color> tile-swatch;
    in property <color> tile-default;
    in-out property <bool> tile-opacity-custom;
    in-out property <float> tile-opacity;
    in-out property <string> panel-color;
    in property <color> panel-swatch;
    in property <color> panel-default;
    in-out property <bool> panel-opacity-custom;
    in-out property <float> panel-opacity;
    in-out property <[ItemRow]> items;
    in-out property <string> ping-host;
    in-out property <int> ping-interval-ms;
    in-out property <bool> alert-cpu;
    in-out property <int> alert-cpu-limit;
    in-out property <bool> alert-gpu;
    in-out property <int> alert-gpu-limit;
    in-out property <bool> alert-battery;
    in-out property <int> alert-battery-limit;
    in-out property <bool> alert-drives;
    in-out property <int> alert-drives-limit;
    // The unit the temperature limits were filled in.
    in property <bool> alert-fahrenheit;
    in property <string> hotkey-show-hide;
    in property <string> hotkey-widget;
    in property <string> hotkey-details;
    in property <string> hotkey-record;
    // Which shortcut, the key's text, then Ctrl, Alt, Shift and Win.
    callback hotkey-pressed(int, string, bool, bool, bool, bool);
    in property <string> version;
    in property <string> config-path;
    in property <string> logs-path;
    in property <string> repo-url;
    in property <string> issues-url;
    in-out property <int> labels;
    in-out property <bool> icons;
    in-out property <bool> hide-in-fullscreen;
    in-out property <bool> lock-position;
    in-out property <string> label-color;
    in property <color> label-swatch;
    in property <color> label-default;
    in-out property <string> value-color;
    in property <color> value-swatch;
    in property <color> value-default;
    in-out property <string> label-color-light;
    in property <color> label-light-swatch;
    in-out property <string> value-color-light;
    in property <color> value-light-swatch;
    in-out property <bool> color-labels;
    in-out property <int> temperature-unit;
    in-out property <int> network-unit;
    in-out property <bool> upload-on-top;
    in-out property <bool> game-strip;
    in-out property <bool> game-summary;
    in-out property <int> popup-detail;
    in-out property <bool> popup-graph;
    in-out property <bool> popup-translucent;
    in-out property <int> popup-processes;
    in property <[string]> styles;
    in property <[string]> color-modes;
    in property <[string]> popup-details;
    in property <[string]> item-popup-details;
    in property <string> diagnostics-status;
    in property <[string]> fonts;
    in-out property <int> font-index;
    in-out property <bool> font-bold;
    in property <[ThemeCard]> themes;
    in-out property <int> theme-index;
    in property <string> theme-status;
    in-out property <string> theme-name;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[string]> adapters;
    in-out property <int> adapter-index;
    in property <[string]> frame-monitors;
    in-out property <int> frame-monitor-index;
    in-out property <[DriveRow]> drive-rows;
    in-out property <bool> widget-enabled;
    in-out property <int> widget-layer;
    in-out property <int> widget-style;
    in-out property <bool> widget-lock;
    in-out property <bool> widget-click-through;
    in-out property <int> widget-detail;
    in-out property <int> widget-width;
    in-out property <float> widget-opacity;
    in-out property <bool> widget-hide-in-fullscreen;
    in-out property <bool> widget-own-items;
    in-out property <[WidgetItemRow]> widget-items;
    in property <[string]> widget-item-styles;
    in property <[string]> widget-item-details;
    in-out property <bool> per-drive;
    in-out property <bool> drive-used;
    property <bool> confirm-reset;

    // Any edit; the app saves shortly after the last one.
    callback changed();
    callback item-enabled(int, bool);
    callback item-color(int, string);
    // Row, field (0 style, 1 colour mode, 2 popup) and the chosen index.
    callback item-choice(int, int, int);
    callback item-expanded(int, bool);
    callback move-item(int, bool);
    callback save-diagnostics();
    callback open-config-folder();
    callback open-logs-folder();
    callback open-link(string);
    callback apply-theme(int);
    callback save-theme(string);
    callback open-themes-folder();
    callback reset-all();
    callback reset-position();
    callback drive-toggled(int, bool);
    callback widget-item-toggled(int, bool);
    // Row, which choice (0 style, 1 detail), new index.
    callback widget-item-choice(int, int, int);
    callback per-drive-selected();

    HorizontalLayout {
        // Navigation
        VerticalLayout {
            width: 230px;
            padding: 12px;
            padding-top: 8px;
            spacing: 4px;
            NavGroup { text: @tr("Overlay"); }
            NavItem {
                icon: Icons.list;
                label: @tr("Items");
                selected: root.tab == 0;
                clicked => { root.tab = 0; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.display;
                label: @tr("Layout");
                selected: root.tab == 1;
                clicked => { root.tab = 1; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.palette;
                label: @tr("Theme");
                selected: root.tab == 2;
                clicked => { root.tab = 2; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.popup;
                label: @tr("Popups");
                selected: root.tab == 3;
                clicked => { root.tab = 3; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.widget;
                label: @tr("Widget");
                selected: root.tab == 4;
                clicked => { root.tab = 4; scroll.content-y = 0; }
            }
            NavGroup { text: @tr("Readings"); }
            NavItem {
                icon: Icons.sensor;
                label: @tr("Sensors");
                selected: root.tab == 5;
                clicked => { root.tab = 5; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.drive;
                label: @tr("Drives and network");
                selected: root.tab == 6;
                clicked => { root.tab = 6; scroll.content-y = 0; }
            }
            NavGroup { text: @tr("App"); }
            NavItem {
                icon: Icons.settings;
                label: @tr("General");
                selected: root.tab == 7;
                clicked => { root.tab = 7; scroll.content-y = 0; }
            }
            NavItem {
                icon: Icons.info;
                label: @tr("About");
                selected: root.tab == 8;
                clicked => { root.tab = 8; scroll.content-y = 0; }
            }
            Rectangle { }
        }

        // Content
        // A layout inside gives the scroll view its content height.
        scroll := ScrollView {
          VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            if root.tab == 0: Page {
                title: @tr("Items");
                Text {
                    text: @tr("Choose what the overlay shows, its order, and each item's colour (empty uses the default). Open an item's options for its graph style, colouring and popup. Right-click an item on the taskbar for the same options.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    for row[i] in root.items: VerticalLayout {
                        if i > 0: Divider { }
                        SettingRow {
                            title: row.name;
                            IconButton {
                                icon: Icons.options;
                                clicked => { root.item-expanded(i, !row.expanded); }
                            }
                            ColorField {
                                text: row.color;
                                swatch: row.swatch;
                                fallback: row.swatch;
                                placeholder: @tr("Default");
                                field-width: 120px;
                                edited(text) => { root.item-color(i, text); }
                            }
                            IconButton {
                                icon: Icons.up;
                                enabled: i > 0;
                                clicked => { root.move-item(i, true); }
                            }
                            IconButton {
                                icon: Icons.down;
                                enabled: i < root.items.length - 1;
                                clicked => { root.move-item(i, false); }
                            }
                            Switch {
                                checked: row.enabled;
                                toggled => { root.item-enabled(i, self.checked); }
                            }
                        }
                        if row.expanded: VerticalLayout {
                            padding-left: 24px;
                            padding-bottom: 4px;
                            if root.mode == 0: SettingRow {
                                title: @tr("Graph style");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.styles;
                                    current-index: row.style;
                                    selected => { root.item-choice(i, 0, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Colour");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.color-modes;
                                    current-index: row.color-mode;
                                    selected => { root.item-choice(i, 1, self.current-index); }
                                }
                            }
                            SettingRow {
                                title: @tr("Popup detail");
                                padding-top: 4px;
                                padding-bottom: 4px;
                                ComboBox {
                                    width: 200px;
                                    model: root.item-popup-details;
                                    current-index: row.popup;
                                    selected => { root.item-choice(i, 2, self.current-index); }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: @tr("Colour by load turns an item green, yellow, orange or red as its value rises: from 50, 75 and 90 %, 70, 80 and 90 °C, and 50, 100 and 200 ms for ping. Other values keep the item colour.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
            }

            if root.tab == 1: Page {
                title: @tr("Layout");
                Card {
                    SettingRow {
                        title: @tr("Mode");
                        description: @tr("Graphs, or compact text only.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Graphs"), @tr("Text only")];
                            current-index <=> root.mode;
                            selected => { root.changed(); }
                        }
                    }
                    if root.mode == 0: Divider { }
                    if root.mode == 0: SettingRow {
                        title: @tr("Single-line graphs");
                        description: @tr("Put the icon, label and value on one line, for short taskbars.");
                        Switch {
                            checked <=> root.graph-inline;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Labels");
                        description: @tr("Full names, one letter per item (C, H, W, M, G, T, D, P), or none with icons alone.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Full"), @tr("Short"), @tr("None (icons only)")];
                            current-index <=> root.labels;
                            selected => {
                                if (root.labels == 2) {
                                    root.icons = true;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Icons");
                        description: @tr("An icon before each label, or on its own.");
                        Switch {
                            checked <=> root.icons;
                            toggled => {
                                if (!self.checked && root.labels == 2) {
                                    root.labels = 0;
                                }
                                root.changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Hide in fullscreen");
                        description: @tr("Fade out while a fullscreen game or video is in front.");
                        Switch {
                            checked <=> root.hide-in-fullscreen;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Text"); }
                Card {
                    SettingRow {
                        title: @tr("Font");
                        description: @tr("Fonts without fixed-width digits may shift slightly as values change.");
                        ComboBox {
                            width: 220px;
                            model: root.fonts;
                            current-index <=> root.font-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Bold");
                        Switch {
                            checked <=> root.font-bold;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Font size");
                        description: @tr("Points.");
                        SpinBox {
                            width: 140px;
                            minimum: 6;
                            maximum: 20;
                            value <=> root.font-size-pt;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Position"); }
                Card {
                    SettingRow {
                        title: @tr("Placement");
                        description: @tr("Where the overlay sits on the taskbar.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Next to the tray"), @tr("Left edge"), @tr("Floating")];
                            current-index <=> root.position;
                            selected => { root.changed(); }
                        }
                    }
                    if root.position == 2: Divider { }
                    if root.position == 2: SettingRow {
                        title: @tr("Lock position");
                        description: @tr("Drag the overlay to move it. Add a panel background so it stays readable over any window.");
                        Button {
                            text: @tr("Reset position");
                            clicked => { root.reset-position(); }
                        }
                        Switch {
                            checked <=> root.lock-position;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Offset");
                        description: @tr("Extra space in pixels, moving away from the anchor.");
                        SpinBox {
                            width: 140px;
                            minimum: -2000;
                            maximum: 2000;
                            step-size: 4;
                            value <=> root.offset-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray fallback margin");
                        description: @tr("Used when the tray position cannot be read.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 2000;
                            step-size: 10;
                            value <=> root.fallback-margin-px;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Every taskbar");
                        description: @tr("Also show on the taskbars of other monitors.");
                        Switch {
                            checked <=> root.show-on-all-taskbars;
                            toggled => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 2: Page {
                title: @tr("Theme");
                ThemeGrid {
                    themes: root.themes;
                    selected: root.theme-index;
                    clicked(i) => { root.apply-theme(i); }
                }
                Text {
                    text: @tr("A theme sets item, label, value, tile and panel colours, with a variant for light taskbars. Choosing one clears the custom colours below.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Save as a theme");
                        description: root.theme-status != "" ? root.theme-status : @tr("Keeps the current colours as a new theme in the themes folder.");
                        LineEdit {
                            width: 160px;
                            placeholder-text: @tr("Name");
                            text <=> root.theme-name;
                        }
                        Button {
                            text: @tr("Save");
                            enabled: root.theme-name != "";
                            clicked => {
                                root.save-theme(root.theme-name);
                                root.theme-name = "";
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Themes folder");
                        description: @tr("Theme files to share or edit. Changes show after choosing the theme again.");
                        Button {
                            text: @tr("Open");
                            clicked => { root.open-themes-folder(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Custom colours"); }
                Card {
                    SettingRow {
                        title: @tr("Label colour");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.label-color;
                            swatch: root.label-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value colour");
                        description: @tr("Empty uses the theme.");
                        ColorField {
                            text <=> root.value-color;
                            swatch: root.value-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Label colour on a light taskbar");
                        description: @tr("Empty uses the label colour above.");
                        ColorField {
                            text <=> root.label-color-light;
                            swatch: root.label-light-swatch;
                            fallback: root.label-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Value colour on a light taskbar");
                        description: @tr("Empty uses the value colour above.");
                        ColorField {
                            text <=> root.value-color-light;
                            swatch: root.value-light-swatch;
                            fallback: root.value-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Colour labels by item");
                        description: @tr("Draw each label in its item's colour.");
                        Switch {
                            checked <=> root.color-labels;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Accent colour graphs");
                        description: @tr("Draw graphs in your Windows accent colour.");
                        Switch {
                            checked <=> root.accent-graphs;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Background"); }
                Card {
                    SettingRow {
                        title: @tr("Tile colour");
                        description: @tr("Empty uses the theme tint.");
                        ColorField {
                            text <=> root.tile-color;
                            swatch: root.tile-swatch;
                            fallback: root.tile-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Custom tile opacity");
                        description: root.tile-opacity-custom ? @tr("{}% — 0% removes the tiles.", Math.round(root.tile-opacity)) : @tr("Using the theme default.");
                        Slider {
                            width: 160px;
                            enabled: root.tile-opacity-custom;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.tile-opacity;
                            changed => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.tile-opacity-custom;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Panel colour");
                        description: @tr("A panel behind the whole overlay. Empty uses the theme.");
                        ColorField {
                            text <=> root.panel-color;
                            swatch: root.panel-swatch;
                            fallback: root.panel-default;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Custom panel opacity");
                        description: !root.panel-opacity-custom ? @tr("Using the theme default.") : root.panel-opacity > 0 ? "\{Math.round(root.panel-opacity)}%" : @tr("Off");
                        Slider {
                            width: 160px;
                            enabled: root.panel-opacity-custom;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.panel-opacity;
                            changed => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.panel-opacity-custom;
                            toggled => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 3: Page {
                title: @tr("Popups");
                Card {
                    SettingRow {
                        title: @tr("Details on hover");
                        description: @tr("Show a graph and details when the mouse rests on an item.");
                        Switch {
                            checked <=> root.hover-popup;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Detail");
                        description: @tr("Simple shows the value and its graph; Detailed adds everything Pulsar reads. Items can choose their own on the Items page.");
                        ComboBox {
                            width: 200px;
                            model: root.popup-details;
                            current-index <=> root.popup-detail;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Translucent background");
                        description: @tr("Blur what is behind the popup. If Windows does not allow it, popups stay solid.");
                        Switch {
                            checked <=> root.popup-translucent;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Graph");
                        description: @tr("The recent history at the top of each popup.");
                        Switch {
                            checked <=> root.popup-graph;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Top processes");
                        description: @tr("Processes listed for CPU, memory, GPU and disk; 0 hides the lists.");
                        SpinBox {
                            width: 140px;
                            minimum: 0;
                            maximum: 15;
                            value <=> root.popup-processes;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 4: Page {
                title: @tr("Widget");
                Text {
                    text: @tr("A panel on the desktop with a graph and details for each item, like a popup that stays open. Drag it to move it; right-click it for the menu.");
                    color: Palette.foreground.transparentize(0.35);
                    wrap: word-wrap;
                }
                Card {
                    SettingRow {
                        title: @tr("Show the widget");
                        Switch {
                            checked <=> root.widget-enabled;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Placement");
                        description: @tr("On the desktop stays behind your windows and comes forward when you show the desktop.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("On the desktop"), @tr("Always on top")];
                            current-index <=> root.widget-layer;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lock position");
                        Switch {
                            checked <=> root.widget-lock;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Click-through while locked");
                        description: @tr("Clicks go to whatever is underneath. Unlock it from the tray icon's menu.");
                        Switch {
                            enabled: root.widget-lock;
                            checked <=> root.widget-click-through;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Hide in fullscreen");
                        description: @tr("While a fullscreen app is on the widget's monitor.");
                        Switch {
                            checked <=> root.widget-hide-in-fullscreen;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Look"); }
                Card {
                    SettingRow {
                        title: @tr("Style");
                        description: @tr("Sparklines: a line per item with a small graph. Tiles: a grid of small graphs. Meters: a bar for the current value.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Sparklines"), @tr("Tiles"), @tr("Meters")];
                            current-index <=> root.widget-style;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Detail");
                        description: root.widget-style == 1 ? @tr("Tiles show the value and graph only.") : @tr("How much each item shows. Colours follow the theme.");
                        ComboBox {
                            width: 200px;
                            model: root.popup-details;
                            current-index <=> root.widget-detail;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Width");
                        description: @tr("Pixels at 100 % scaling.");
                        SpinBox {
                            width: 140px;
                            minimum: 220;
                            maximum: 600;
                            step-size: 20;
                            value <=> root.widget-width;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Background opacity");
                        description: "\{Math.round(root.widget-opacity)}%";
                        Slider {
                            width: 200px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.widget-opacity;
                            changed => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Items"); }
                Card {
                    SettingRow {
                        title: @tr("Choose items");
                        description: @tr("Off shows the same items as the taskbar.");
                        Switch {
                            checked <=> root.widget-own-items;
                            toggled => { root.changed(); }
                        }
                    }
                    for row[i] in root.widget-items: VerticalLayout {
                        Divider { }
                        SettingRow {
                            title: row.name;
                            ComboBox {
                                width: 150px;
                                model: root.widget-item-styles;
                                current-index: row.style;
                                selected => { root.widget-item-choice(i, 0, self.current-index); }
                            }
                            ComboBox {
                                width: 150px;
                                model: root.widget-item-details;
                                current-index: row.detail;
                                selected => { root.widget-item-choice(i, 1, self.current-index); }
                            }
                            Switch {
                                enabled: root.widget-own-items;
                                checked: row.checked;
                                toggled => { root.widget-item-toggled(i, self.checked); }
                            }
                        }
                    }
                }
            }

            if root.tab == 5: Page {
                title: @tr("Sensors");
                SectionTitle { text: @tr("Temperatures and power"); }
                Card {
                    SettingRow {
                        title: @tr("Sensor service");
                        description: @tr("CPU temperature, CPU power and chipset temperature need the optional Pulsar sensor service and the PawnIO driver, both of which need administrator rights. Run the Pulsar installer again to add them. Intel CPUs, and AMD Ryzen from Zen onwards; chipset temperature on Intel only. Frame rate needs the service but not PawnIO.");
                        Button {
                            text: @tr("About PawnIO");
                            clicked => { root.open-link("https://pawnio.eu"); }
                        }
                    }
                }
                SectionTitle { text: @tr("Frame rate"); }
                Card {
                    SettingRow {
                        title: @tr("Measure");
                        description: @tr("The app in front counts the frames it draws, on whichever monitor it is. A monitor counts how often its picture changes, whichever apps draw it.");
                        ComboBox {
                            width: 260px;
                            model: root.frame-monitors;
                            current-index <=> root.frame-monitor-index;
                            selected => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Games"); }
                Card {
                    SettingRow {
                        title: @tr("Show the strip in games");
                        description: @tr("While a game is in front, the frame rate and your taskbar items appear in the top-left corner of its monitor. Borderless and windowed games only.");
                        Switch {
                            checked <=> root.game-strip;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Summary when a game closes");
                        description: @tr("A notification with the time played, frame rate and peak temperatures, also saved to sessions.csv in the logs folder.");
                        Switch {
                            checked <=> root.game-summary;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Which apps are games");
                        description: @tr("The games Windows recognises, as Game Bar does. To change that for an app, bring it to the front, then right-click Pulsar and use Count as a game.");
                    }
                }
                SectionTitle { text: @tr("Units"); }
                Card {
                    SettingRow {
                        title: @tr("Temperature");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Celsius (°C)"), @tr("Fahrenheit (°F)")];
                            current-index <=> root.temperature-unit;
                            selected => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 6: Page {
                title: @tr("Drives and network");
                SectionTitle { text: @tr("Disk"); }
                Card {
                    SettingRow {
                        title: @tr("Disks");
                        description: @tr("One combined cell, or a cell per drive.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("All disks combined"), @tr("Each drive")];
                            current-index: root.per-drive ? 1 : 0;
                            selected => {
                                root.per-drive = self.current-index == 1;
                                root.per-drive-selected();
                            }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drives");
                        for drive[i] in root.drive-rows: CheckBox {
                            text: drive.letter + ":";
                            checked: drive.checked;
                            toggled => { root.drive-toggled(i, self.checked); }
                        }
                    }
                    if root.per-drive: Divider { }
                    if root.per-drive: SettingRow {
                        title: @tr("Drive value");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Activity"), @tr("Used space")];
                            current-index: root.drive-used ? 1 : 0;
                            selected => {
                                root.drive-used = self.current-index == 1;
                                root.changed();
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Network"); }
                Card {
                    SettingRow {
                        title: @tr("Adapter");
                        description: @tr("Count one adapter, or every physical one.");
                        ComboBox {
                            width: 260px;
                            model: root.adapters;
                            current-index <=> root.adapter-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Network rates");
                        description: @tr("Disk speeds stay in bytes.");
                        ComboBox {
                            width: 200px;
                            model: [@tr("Bytes per second (MB/s)"), @tr("Bits per second (Mbps)")];
                            current-index <=> root.network-unit;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Upload on top");
                        description: @tr("Show the upload rate above the download rate.");
                        Switch {
                            checked <=> root.upload-on-top;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Ping"); }
                Card {
                    SettingRow {
                        title: @tr("Host");
                        description: @tr("An IPv4 address or a name.");
                        LineEdit {
                            width: 200px;
                            text <=> root.ping-host;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Interval");
                        description: @tr("Milliseconds between pings.");
                        SpinBox {
                            width: 140px;
                            minimum: 1000;
                            maximum: 60000;
                            step-size: 500;
                            value <=> root.ping-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                }
            }

            if root.tab == 7: Page {
                title: @tr("General");
                Card {
                    SettingRow {
                        title: @tr("Language");
                        description: @tr("For Pulsar's windows, menus and labels.");
                        ComboBox {
                            width: 200px;
                            model: root.languages;
                            current-index <=> root.language-index;
                            selected => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Start with Windows");
                        description: @tr("Launch Pulsar when you sign in.");
                        Switch {
                            checked <=> root.autostart;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Check for updates");
                        description: @tr("Look for a new release once a day. Nothing is downloaded automatically.");
                        Switch {
                            checked <=> root.update-check;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Tray icon");
                        description: @tr("Show Pulsar in the notification area. When hidden, right-click the overlay for the menu, or start Pulsar again to open Settings.");
                        Switch {
                            checked <=> root.tray-icon;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Shortcuts"); }
                Card {
                    SettingRow {
                        title: @tr("Keyboard shortcuts");
                        description: @tr("Select a box and press the keys, with Ctrl, Alt or Win. Backspace clears it. They work anywhere in Windows.");
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Show or hide Pulsar");
                        HotkeyField {
                            text: root.hotkey-show-hide;
                            pressed(event) => {
                                root.hotkey-pressed(0, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Turn the desktop widget on or off");
                        HotkeyField {
                            text: root.hotkey-widget;
                            pressed(event) => {
                                root.hotkey-pressed(1, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Open system details");
                        HotkeyField {
                            text: root.hotkey-details;
                            pressed(event) => {
                                root.hotkey-pressed(2, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Start or stop recording to CSV");
                        HotkeyField {
                            text: root.hotkey-record;
                            pressed(event) => {
                                root.hotkey-pressed(3, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                        }
                    }
                }
                SectionTitle { text: @tr("Alerts"); }
                Card {
                    SettingRow {
                        title: root.alert-fahrenheit ? @tr("CPU temperature (°F)") : @tr("CPU temperature (°C)");
                        description: @tr("When it stays at or above this for half a minute. Needs the sensor service.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-cpu;
                            minimum: root.alert-fahrenheit ? 122 : 50;
                            maximum: root.alert-fahrenheit ? 230 : 110;
                            value <=> root.alert-cpu-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-cpu;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: root.alert-fahrenheit ? @tr("GPU temperature (°F)") : @tr("GPU temperature (°C)");
                        description: @tr("When it stays at or above this for half a minute.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-gpu;
                            minimum: root.alert-fahrenheit ? 122 : 50;
                            maximum: root.alert-fahrenheit ? 230 : 110;
                            value <=> root.alert-gpu-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-gpu;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Battery charge (%)");
                        description: @tr("When it falls to this on battery power.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-battery;
                            minimum: 5;
                            maximum: 50;
                            value <=> root.alert-battery-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-battery;
                            toggled => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Drive free space (%)");
                        description: @tr("When any drive falls to this.");
                        SpinBox {
                            width: 120px;
                            enabled: root.alert-drives;
                            minimum: 1;
                            maximum: 50;
                            value <=> root.alert-drives-limit;
                            edited => { root.changed(); }
                        }
                        Switch {
                            checked <=> root.alert-drives;
                            toggled => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Sampling"); }
                Card {
                    SettingRow {
                        title: @tr("Update interval");
                        description: @tr("Milliseconds between readings.");
                        SpinBox {
                            width: 140px;
                            minimum: 500;
                            maximum: 5000;
                            step-size: 250;
                            value <=> root.sample-interval-ms;
                            edited => { root.changed(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("History length");
                        description: @tr("Readings kept for the graphs.");
                        SpinBox {
                            width: 140px;
                            minimum: 10;
                            maximum: 600;
                            step-size: 10;
                            value <=> root.history-len;
                            edited => { root.changed(); }
                        }
                    }
                }
                SectionTitle { text: @tr("Reset"); }
                Card {
                    SettingRow {
                        title: @tr("Reset all settings");
                        description: root.confirm-reset ? @tr("Everything except Start with Windows and the language goes back to its default.") : @tr("Start over with the default look and items.");
                        if !root.confirm-reset: Button {
                            text: @tr("Reset…");
                            clicked => { root.confirm-reset = true; }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Reset");
                            primary: true;
                            clicked => {
                                root.confirm-reset = false;
                                root.reset-all();
                            }
                        }
                        if root.confirm-reset: Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-reset = false; }
                        }
                    }
                }
            }

            if root.tab == 8: Page {
                title: @tr("About");
                Card {
                    HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Image {
                            source: @image-url("../assets/pulsar-64.png");
                            width: 48px;
                            height: 48px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: @tr("Pulsar {}", root.version);
                                font-size: 20px;
                                font-weight: 600;
                            }
                            Text {
                                text: @tr("A Windows 11 taskbar system monitor.");
                                color: Palette.foreground.transparentize(0.35);
                            }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("License");
                        description: @tr("GNU General Public License v3.0 or later. Built with Slint.");
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Settings file");
                        description: root.config-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-config-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Logs");
                        description: root.logs-path;
                        Button {
                            text: @tr("Open folder");
                            clicked => { root.open-logs-folder(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Diagnostics");
                        description: root.diagnostics-status != "" ? root.diagnostics-status : @tr("Save every reading Pulsar can take to a text file in the logs folder, to attach to an issue. It lists process and network adapter names; read it before sharing.");
                        Button {
                            text: @tr("Save report");
                            clicked => { root.save-diagnostics(); }
                        }
                    }
                }
                Card {
                    SettingRow {
                        title: @tr("Source code");
                        description: root.repo-url;
                        Button {
                            text: @tr("Open on GitHub");
                            clicked => { root.open-link(root.repo-url); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Report a problem");
                        description: @tr("Attach pulsar.log, and any crash report, from the logs folder.");
                        Button {
                            text: @tr("Report an issue");
                            clicked => { root.open-link(root.issues-url); }
                        }
                    }
                }
            }
          }
        }
    }
}
